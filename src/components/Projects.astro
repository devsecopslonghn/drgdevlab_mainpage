---
const projects = [
  {
    title: 'Banking CI/CD Pipeline System',
    desc: 'End-to-end CI/CD platform for Core T24, Open Banking, and Payment applications. Built on GitLab CI and Jenkins with full approval workflows, security scanning, and compliance gates for banking-grade releases.',
    tags: ['GitLab CI', 'Jenkins', 'OpenShift', 'Groovy'],
    icon: 'account_tree',
    badge: 'BANKING CORE',
    borderClass: 'border-primary/20 hover:border-primary/50',
    textClass: 'text-primary',
    bgClass: 'bg-primary/10',
    metrics: ['50% faster', '75% more frequent', '0 downtime'],
    status: 'PRODUCTION'
  },
  {
    title: 'Database CI/CD Automation',
    desc: 'Automated database lifecycle management for banking systems. Schema versioning, migration automation, rollback strategies, and compliance audit trails for every database change across Core T24 and payment databases.',
    tags: ['Flyway', 'Ansible', 'Bash', 'GitLab CI'],
    icon: 'storage',
    badge: 'DATA INTEGRITY',
    borderClass: 'border-orange-500/20 hover:border-orange-400/50',
    textClass: 'text-orange-400',
    bgClass: 'bg-orange-500/10',
    metrics: ['Schema v4.2.1', '100% audit trail', 'Instant rollback'],
    status: 'PRODUCTION'
  },
  {
    title: 'OpenShift Deployment Platform',
    desc: 'Enterprise container orchestration platform on OpenShift OCP for all banking microservices. Manages multi-environment deployments, pod scaling, rolling updates, and health checks across Core Banking infrastructure.',
    tags: ['OpenShift OCP', 'Kubernetes', 'Ansible', 'Helm'],
    icon: 'hub',
    badge: 'PLATFORM',
    borderClass: 'border-blue-500/20 hover:border-blue-400/50',
    textClass: 'text-blue-400',
    bgClass: 'bg-blue-500/10',
    metrics: ['99% uptime', '6 environments', 'Self-healing'],
    status: 'PRODUCTION'
  },
  {
    title: 'Payment System Deployment Pipeline',
    desc: 'Mission-critical deployment pipeline for payment gateway systems. Features strict pre-deployment validation, transaction-safe rollout windows, real-time monitoring integration, and automated incident response.',
    tags: ['Jenkins', 'Bash', 'OpenShift', 'Grafana'],
    icon: 'payments',
    badge: 'PAYMENTS',
    borderClass: 'border-yellow-500/20 hover:border-yellow-400/50',
    textClass: 'text-yellow-400',
    bgClass: 'bg-yellow-500/10',
    metrics: ['2.4M tx/day', 'Zero failures', '< 5s rollback'],
    status: 'PRODUCTION'
  }
];
---

<section id="projects" class="px-6 py-20 lg:px-20">
  <div class="mx-auto max-w-[1200px]">

    <div class="mb-12 reveal">
      <div class="inline-flex items-center gap-2 rounded-full border border-border-dark bg-surface-dark px-4 py-1.5 font-mono text-xs text-text-muted mb-4">
        <span class="material-symbols-outlined text-sm text-primary">folder_special</span>
        projects
      </div>
      <h2 class="text-3xl font-black text-white lg:text-4xl">
        Production <span class="text-transparent bg-clip-text bg-gradient-to-r from-primary to-emerald-400">Systems</span> Built
      </h2>
      <p class="mt-3 text-text-muted font-body">Deployed in live banking environments. Not demos.</p>
    </div>

    <div class="grid gap-6 md:grid-cols-2">
      {projects.map((p, i) => (
        <div class={`reveal reveal-delay-${(i % 2) + 1} group rounded-xl border ${p.borderClass} bg-surface-dark transition-all duration-200 hover:translate-y-[-2px] overflow-hidden`}>
          <!-- Card header -->
          <div class="flex items-start justify-between p-6 border-b border-border-dark bg-[#161f1a]">
            <div class="flex items-center gap-3">
              <div class={`flex h-11 w-11 flex-shrink-0 items-center justify-center rounded-lg border ${p.borderClass.split(' ')[0]} ${p.bgClass}`}>
                <span class={`material-symbols-outlined ${p.textClass}`}>{p.icon}</span>
              </div>
              <div>
                <span class={`font-mono text-[10px] font-bold ${p.textClass} uppercase tracking-wider`}>{p.badge}</span>
                <h3 class="text-base font-bold text-white mt-0.5">{p.title}</h3>
              </div>
            </div>
            <span class={`flex-shrink-0 rounded-full border ${p.borderClass.split(' ')[0]} ${p.bgClass} ${p.textClass} px-2 py-0.5 font-mono text-[10px] font-bold`}>{p.status}</span>
          </div>

          <!-- Description -->
          <div class="p-6 pb-4">
            <p class="text-sm font-body text-text-muted leading-relaxed">{p.desc}</p>
          </div>

          <!-- Metrics -->
          <div class="flex flex-wrap gap-2 px-6 pb-4">
            {p.metrics.map(m => (
              <span class={`rounded border ${p.borderClass.split(' ')[0]} ${p.bgClass} ${p.textClass} px-2.5 py-1 font-mono text-xs font-bold`}>{m}</span>
            ))}
          </div>

          <!-- Tech tags -->
          <div class="flex flex-wrap gap-2 px-6 pb-6 border-t border-border-dark pt-4">
            {p.tags.map(t => (
              <span class="rounded border border-border-dark bg-background-dark px-2.5 py-1 font-mono text-xs text-text-muted">{t}</span>
            ))}
          </div>
        </div>
      ))}
    </div>

  </div>
</section>
