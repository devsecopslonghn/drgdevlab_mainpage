    </div>
    <span class="font-bold text-white text-lg tracking-tight">longho<span class="text-primary">.</span></span>
  </a>

  <div class="hidden md:flex items-center gap-6 font-mono text-sm text-text-muted">
    <a href="#about" class="hover:text-primary transition-colors duration-200">About</a>
    <a href="#experience" class="hover:text-primary transition-colors duration-200">Experience</a>
    <a href="#banking" class="hover:text-primary transition-colors duration-200">Banking</a>
