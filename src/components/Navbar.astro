---
---
<nav id="navbar" class="sticky top-0 z-50 flex w-full items-center justify-between border-b border-border-dark bg-background-dark/95 backdrop-blur-sm px-6 py-4 lg:px-20 transition-all duration-300">
  <a href="/" class="flex items-center gap-3 group">
    <div class="flex size-8 items-center justify-center rounded bg-surface-dark border border-primary/30 text-primary">
      <span class="material-symbols-outlined text-base">terminal</span>
    </div>
    <span class="font-bold text-white text-lg tracking-tight">longho<span class="text-primary">.</span></span>
  </a>

  <div class="hidden md:flex items-center gap-6 font-mono text-sm text-text-muted">
    <a href="/#about" data-astro-reload class="hover:text-primary transition-colors duration-200">About</a>
    <a href="/experience" class="hover:text-primary transition-colors duration-200">Experience</a>
    <a href="/experience#banking" data-astro-reload class="hover:text-primary transition-colors duration-200">Banking</a>
    <a href="/projects" class="hover:text-primary transition-colors duration-200">Projects</a>
    <a href="/experience#skills" data-astro-reload class="hover:text-primary transition-colors duration-200">Skills</a>
    <a href="/projects#terminal" data-astro-reload class="hover:text-primary transition-colors duration-200">Terminal</a>
    <a href="/#contact" data-astro-reload class="hover:text-primary transition-colors duration-200">Contact</a>
  </div>

  <div class="hidden md:flex items-center gap-3">
    <div class="flex items-center gap-2 rounded-full border border-primary/20 bg-primary/5 px-3 py-1.5 font-mono text-[10px] text-primary">
      <span class="relative flex h-1.5 w-1.5">
        <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-primary opacity-75"></span>
        <span class="relative inline-flex rounded-full h-1.5 w-1.5 bg-primary"></span>
      </span>
      AVAILABLE
    </div>

    <!-- Theme toggle -->
    <button
      id="theme-toggle"
      aria-label="Toggle theme"
      class="flex size-9 items-center justify-center rounded-lg border border-border-dark bg-surface-dark text-text-muted hover:border-primary/30 hover:text-primary transition-colors"
    >
      <span class="material-symbols-outlined text-base" id="theme-icon">light_mode</span>
    </button>

    <a
      href="/cv"
      class="flex items-center gap-1.5 rounded-lg border border-border-dark bg-surface-dark px-4 py-2 text-xs font-bold text-white hover:border-primary/30 hover:text-primary transition-colors"
    >
      <span class="material-symbols-outlined text-sm">description</span>
      Resume
    </a>
  </div>

  <div class="md:hidden flex items-center gap-2">
    <button
      id="theme-toggle-mobile"
      aria-label="Toggle theme"
      class="flex size-9 items-center justify-center rounded-lg border border-border-dark bg-surface-dark text-text-muted hover:text-primary transition-colors"
    >
      <span class="material-symbols-outlined text-base" id="theme-icon-mobile">light_mode</span>
    </button>
    <button id="mobile-menu-btn" class="text-text-muted hover:text-primary transition-colors">
      <span class="material-symbols-outlined" id="mobile-menu-icon">menu</span>
    </button>
  </div>
</nav>

<div id="mobile-menu" class="hidden fixed top-[65px] inset-x-0 z-40 bg-background-dark/98 backdrop-blur-md border-b border-border-dark px-6 py-6 font-mono text-sm">
  <div class="flex flex-col gap-5">
    <a href="/#about" data-astro-reload class="text-text-muted hover:text-primary transition-colors">About</a>
    <a href="/experience" class="text-text-muted hover:text-primary transition-colors">Experience</a>
    <a href="/experience#banking" data-astro-reload class="text-text-muted hover:text-primary transition-colors">Banking</a>
    <a href="/projects" class="text-text-muted hover:text-primary transition-colors">Projects</a>
    <a href="/experience#skills" data-astro-reload class="text-text-muted hover:text-primary transition-colors">Skills</a>
    <a href="/projects#terminal" data-astro-reload class="text-text-muted hover:text-primary transition-colors">Terminal</a>
    <a href="/#contact" data-astro-reload class="text-text-muted hover:text-primary transition-colors">Contact</a>
    <a href="/cv" class="text-primary font-bold border-t border-border-dark pt-4">↓ View Resume</a>
  </div>
</div>

<script>
  // ── Mobile menu ──────────────────────────────────────────
  const btn = document.getElementById('mobile-menu-btn');
  const menu = document.getElementById('mobile-menu');
  const icon = document.getElementById('mobile-menu-icon');
  let open = false;
  btn?.addEventListener('click', () => {
    open = !open;
    menu?.classList.toggle('hidden', !open);
    if (icon) icon.textContent = open ? 'close' : 'menu';
  });
  menu?.querySelectorAll('a').forEach((link) => {
    link.addEventListener('click', () => {
      open = false;
      menu.classList.add('hidden');
      if (icon) icon.textContent = 'menu';
    });
  });

  // ── Theme toggle ─────────────────────────────────────────
  function applyTheme(theme: string) {
    const html = document.documentElement;
    if (theme === 'light') {
      html.classList.remove('dark');
      html.classList.add('light');
    } else {
      html.classList.remove('light');
      html.classList.add('dark');
    }
    const icon = theme === 'dark' ? 'light_mode' : 'dark_mode';
    const desktopIcon = document.getElementById('theme-icon');
    const mobileIcon = document.getElementById('theme-icon-mobile');
    if (desktopIcon) desktopIcon.textContent = icon;
    if (mobileIcon) mobileIcon.textContent = icon;
  }

  function toggleTheme() {
    const isDark = document.documentElement.classList.contains('dark');
    const next = isDark ? 'light' : 'dark';
    localStorage.setItem('theme', next);
    applyTheme(next);
  }

  // Sync icon on every page load (including ViewTransitions navigation)
  function syncIcon() {
    const saved = localStorage.getItem('theme') || 'dark';
    const icon = saved === 'dark' ? 'light_mode' : 'dark_mode';
    const desktopIcon = document.getElementById('theme-icon');
    const mobileIcon = document.getElementById('theme-icon-mobile');
    if (desktopIcon) desktopIcon.textContent = icon;
    if (mobileIcon) mobileIcon.textContent = icon;
  }

  syncIcon();
  document.addEventListener('astro:page-load', syncIcon);

  document.getElementById('theme-toggle')?.addEventListener('click', toggleTheme);
  document.getElementById('theme-toggle-mobile')?.addEventListener('click', toggleTheme);
</script>
