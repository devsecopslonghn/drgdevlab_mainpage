    <a href="#skills" class="hover:text-primary transition-colors duration-200">Skills</a>
    <a href="#terminal" class="hover:text-primary transition-colors duration-200">Terminal</a>
    <a href="#contact" class="hover:text-primary transition-colors duration-200">Contact</a>
  </div>

  <div class="hidden md:flex items-center gap-3">
    <div class="flex items-center gap-2 rounded-full border border-primary/20 bg-primary/5 px-3 py-1.5 font-mono text-[10px] text-primary">
      <span class="relative flex h-1.5 w-1.5">
        <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-primary opacity-75"></span>
        <span class="relative inline-flex rounded-full h-1.5 w-1.5 bg-primary"></span>
      </span>
      AVAILABLE
    </div>
    <a
      href="/resume/Long_Ho_DevOps_Resume.pdf"
      target="_blank"
      class="flex items-center gap-1.5 rounded-lg border border-border-dark bg-surface-dark px-4 py-2 text-xs font-bold text-white hover:border-primary/30 hover:text-primary transition-colors"
    >
      <span class="material-symbols-outlined text-sm">download</span>
      Resume
    </a>
  </div>

  <button id="mobile-menu-btn" class="md:hidden text-text-muted hover:text-primary transition-colors">
    <span class="material-symbols-outlined" id="mobile-menu-icon">menu</span>
  </button>
</nav>

<div id="mobile-menu" class="hidden fixed top-[65px] inset-x-0 z-40 bg-background-dark/98 backdrop-blur-md border-b border-border-dark px-6 py-6 font-mono text-sm">
  <div class="flex flex-col gap-5">
    <a href="#about" class="text-text-muted hover:text-primary transition-colors">About</a>
    <a href="#experience" class="text-text-muted hover:text-primary transition-colors">Experience</a>
    <a href="#banking" class="text-text-muted hover:text-primary transition-colors">Banking</a>
    <a href="#projects" class="text-text-muted hover:text-primary transition-colors">Projects</a>
    <a href="#skills" class="text-text-muted hover:text-primary transition-colors">Skills</a>
    <a href="#terminal" class="text-text-muted hover:text-primary transition-colors">Terminal</a>
    <a href="#contact" class="text-text-muted hover:text-primary transition-colors">Contact</a>
    <a href="/resume/Long_Ho_DevOps_Resume.pdf" target="_blank" class="text-primary font-bold border-t border-border-dark pt-4">
      ↓ Download Resume
    </a>
  </div>
</div>

<script>
  const btn = document.getElementById('mobile-menu-btn');
  const menu = document.getElementById('mobile-menu');
  const icon = document.getElementById('mobile-menu-icon');
  let open = false;
  btn?.addEventListener('click', () => {
    open = !open;
    menu?.classList.toggle('hidden', !open);
    if (icon) icon.textContent = open ? 'close' : 'menu';
  });
  menu?.querySelectorAll('a').forEach((link) => {
    link.addEventListener('click', () => {
      open = false;
      menu.classList.add('hidden');
      if (icon) icon.textContent = 'menu';
    });
  });
</script>
