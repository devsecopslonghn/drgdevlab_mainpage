---
---
<section id="hero" class="relative w-full px-6 py-12 md:py-16 lg:px-20 overflow-hidden">
  <!-- Background grid -->
  <div class="pointer-events-none absolute inset-0 bg-[linear-gradient(to_right,#283930_1px,transparent_1px),linear-gradient(to_bottom,#283930_1px,transparent_1px)] bg-[size:48px_48px] opacity-[0.08]"></div>
  <!-- Radial glow -->
  <div class="pointer-events-none absolute left-0 top-0 h-[500px] w-[500px] -translate-x-1/2 -translate-y-1/2 rounded-full bg-primary/5 blur-3xl"></div>

  <div class="relative mx-auto max-w-[1200px]">
    <div class="grid gap-12 lg:grid-cols-2 lg:gap-16 items-center">

      <!-- Left -->
      <div class="flex flex-col gap-8">
        <div class="flex flex-col gap-5">
          <div class="inline-flex items-center gap-2 rounded-full border border-primary/20 bg-primary/5 px-4 py-1.5 font-mono text-xs text-primary w-fit">
            <span class="material-symbols-outlined text-sm">location_on</span>
            Ho Chi Minh City, Vietnam
          </div>
          <h1 class="text-5xl font-black leading-[1.05] tracking-tight text-white lg:text-6xl xl:text-7xl">
            Long<br />
            <span class="text-transparent bg-clip-text bg-gradient-to-r from-primary via-emerald-400 to-teal-500">Ho.</span>
          </h1>
          <div class="flex items-center gap-3 font-mono text-sm text-text-muted">
            <span class="h-px w-8 bg-primary"></span>
            <span>DevOps Engineer — Banking Domain</span>
          </div>
          <p class="text-lg font-body leading-relaxed text-text-muted max-w-[480px]">
            I build <span class="text-white font-semibold">secure</span>, <span class="text-white font-semibold">scalable</span>, and <span class="text-white font-semibold">reliable</span> banking systems with <span class="text-primary font-semibold">zero-downtime deployments.</span>
          </p>
        </div>

        <!-- Tags -->
        <div class="flex flex-wrap gap-2 font-mono text-xs">
          {['Core T24', 'Open Banking', 'Payment Systems', 'OpenShift OCP', 'GitLab CI', 'Jenkins', 'Ansible'].map(tag => (
            <span class="rounded border border-border-dark bg-surface-dark px-3 py-1.5 text-text-muted hover:border-primary/30 hover:text-primary transition-colors cursor-default">{tag}</span>
          ))}
        </div>

        <!-- CTAs -->
        <div class="flex flex-wrap gap-4">
          <a
            href="/experience"
            class="flex h-12 items-center gap-2 rounded-lg bg-primary px-6 text-sm font-bold text-background-dark hover:bg-primary-hover transition-colors"
          >
            <span class="material-symbols-outlined text-sm">work</span>
            View Experience
          </a>
          <a
            href="#contact"
            class="flex h-12 items-center gap-2 rounded-lg border border-border-dark bg-surface-dark px-6 text-sm font-bold text-white hover:border-primary/30 hover:text-primary transition-colors"
          >
            <span class="material-symbols-outlined text-sm">mail</span>
            Get In Touch
          </a>
        </div>
      </div>

      <!-- Right: Terminal -->
      <div class="relative w-full overflow-hidden rounded-xl border border-border-dark bg-surface-dark shadow-2xl shadow-black/40">
        <!-- Terminal header -->
        <div class="flex items-center gap-2 border-b border-border-dark bg-background-dark/70 px-4 py-3">
          <div class="h-3 w-3 rounded-full bg-red-500/80"></div>
          <div class="h-3 w-3 rounded-full bg-yellow-500/80"></div>
          <div class="h-3 w-3 rounded-full bg-green-500/80"></div>
          <div class="ml-auto font-mono text-xs text-text-muted">longho@sacombank-prod ~</div>
        </div>

        <!-- Terminal body -->
        <div class="p-5 font-mono text-xs space-y-3 min-h-[320px]">
          <div class="text-text-muted">
            <span class="text-primary">→</span> deploy --env prod --app core-t24 --strategy rolling
          </div>
          <div class="space-y-1 pl-2 text-text-muted/70 leading-relaxed">
            <div><span class="text-primary">✓</span> Pre-deployment health check <span class="text-primary">passed</span></div>
            <div><span class="text-primary">✓</span> Database migration applied <span class="text-white">(schema v3.2.1)</span></div>
            <div><span class="text-primary">✓</span> Security scan <span class="text-primary">passed</span> — 0 critical findings</div>
            <div><span class="text-yellow-400">↻</span> Rolling update in progress <span class="text-text-muted">[OpenShift OCP]</span></div>
            <div class="pl-4 text-text-muted/50">pods: 0/6 → 2/6 → 4/6 → 6/6 ✓</div>
            <div><span class="text-primary">✓</span> Zero-downtime achieved — <span class="text-primary">100%</span> traffic served</div>
            <div><span class="text-primary">✓</span> Post-deploy smoke tests <span class="text-primary">passed</span></div>
          </div>

          <div class="border-t border-border-dark pt-3 mt-3">
            <div class="text-text-muted"><span class="text-primary">→</span> status --all-systems</div>
            <div class="mt-2 space-y-1 pl-2 text-text-muted/70">
              <div><span class="text-primary">●</span> core-t24              <span class="text-primary">RUNNING</span> <span class="text-text-muted/40">uptime 99.99%</span></div>
              <div><span class="text-primary">●</span> open-banking-api      <span class="text-primary">RUNNING</span> <span class="text-text-muted/40">uptime 99.97%</span></div>
              <div><span class="text-primary">●</span> payment-gateway       <span class="text-primary">RUNNING</span> <span class="text-text-muted/40">uptime 99.98%</span></div>
            </div>
          </div>

          <div class="flex items-center gap-1 text-text-muted">
            <span class="text-primary">→</span>
            <span class="animate-pulse">█</span>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
