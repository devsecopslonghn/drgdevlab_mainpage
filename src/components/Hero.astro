---
const {
  badge = 'Hello',
  name = '',
  role = '',
  highlight = '',
  description = '',
  primaryCta = { label: '', href: '#' },
  secondaryCta = { label: '', href: '#' },
  portrait = '',
  stats = []
} = Astro.props;
---

<section class="relative w-full overflow-hidden flex-1 flex flex-col justify-center">
  <div class="absolute top-0 right-0 -mr-20 -mt-20 w-[500px] h-[500px] bg-primary/20 rounded-full blur-[128px] pointer-events-none"></div>
  <div class="absolute bottom-0 left-0 -ml-20 -mb-20 w-[400px] h-[400px] bg-purple-500/10 rounded-full blur-[100px] pointer-events-none"></div>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16 lg:py-24 relative z-10 w-full">
    <div class="flex flex-col lg:flex-row gap-12 lg:gap-20 items-center">
      <div class="flex-1 flex flex-col gap-6 text-center lg:text-left">
        <div class="flex flex-col gap-2">
          <div class="inline-flex items-center justify-center lg:justify-start gap-2 text-primary font-bold text-sm tracking-wide uppercase">
            <span class="w-8 h-[2px] bg-primary rounded-full"></span>
            {badge} {name}
          </div>
          <h1 class="text-5xl sm:text-6xl lg:text-7xl font-black tracking-tight leading-[1.1]">
            {role} <br />
            <span class="text-transparent bg-clip-text bg-gradient-to-r from-primary to-purple-400">{highlight}</span>
          </h1>
        </div>
        <p class="text-slate-600 dark:text-slate-400 text-lg sm:text-xl leading-relaxed max-w-2xl mx-auto lg:mx-0">
          {description}
        </p>
        <div class="flex flex-wrap gap-4 justify-center lg:justify-start pt-4">
          {primaryCta.label && (
            <a
              class="inline-flex items-center justify-center h-12 px-8 rounded-lg bg-primary hover:bg-primary-hover text-white font-semibold transition-all shadow-[0_0_20px_-5px_rgba(19,91,236,0.5)]"
              href={primaryCta.href}
            >
              {primaryCta.label}
            </a>
          )}
          {secondaryCta.label && (
            <a
              class="inline-flex items-center justify-center h-12 px-8 rounded-lg border border-slate-300 dark:border-slate-700 hover:bg-slate-100 dark:hover:bg-surface-border text-slate-900 dark:text-white font-medium transition-colors"
              href={secondaryCta.href}
            >
              {secondaryCta.label}
            </a>
          )}
        </div>
        <div class="mt-8 hidden sm:block mx-auto lg:mx-0 max-w-md w-full bg-[#1e1e1e] rounded-lg border border-slate-800 shadow-2xl overflow-hidden font-mono text-xs opacity-90">
          <div class="bg-[#2d2d2d] px-3 py-2 flex gap-1.5 border-b border-black/50">
            <div class="w-2.5 h-2.5 rounded-full bg-[#ff5f56]"></div>
            <div class="w-2.5 h-2.5 rounded-full bg-[#ffbd2e]"></div>
            <div class="w-2.5 h-2.5 rounded-full bg-[#27c93f]"></div>
          </div>
          <div class="p-4 text-green-400">
            <div class="flex gap-2">
              <span class="text-blue-400">➜</span>
              <span class="text-white">~</span>
              <span>whoami</span>
            </div>
            <div class="text-slate-300 mt-1">DevOps Enthusiast | Cloud Architect</div>
            <div class="flex gap-2 mt-3">
              <span class="text-blue-400">➜</span>
              <span class="text-white">~</span>
              <span class="animate-pulse">_</span>
            </div>
          </div>
        </div>
      </div>
      <div class="flex-1 w-full max-w-[500px] lg:max-w-none relative group">
        <div class="absolute inset-0 bg-gradient-to-tr from-primary to-purple-500 rounded-2xl transform rotate-3 scale-[1.02] opacity-30 group-hover:opacity-50 transition-opacity duration-500 blur-sm"></div>
        <div class="absolute inset-0 bg-surface-dark rounded-2xl transform -rotate-2 border border-surface-border"></div>
        <div class="relative w-full aspect-[4/5] sm:aspect-square lg:aspect-[4/5] rounded-xl overflow-hidden shadow-2xl bg-surface-dark border border-slate-700">
          {portrait && (
            <img
              src={portrait}
              alt="Professional portrait"
              class="w-full h-full object-cover opacity-90 hover:scale-105 transition-transform duration-700"
            />
          )}
          <div class="absolute inset-0 bg-gradient-to-t from-background-dark/90 via-transparent to-transparent"></div>
          {stats.length > 0 && (
            <div class="absolute bottom-6 left-6 right-6">
              <div class="flex gap-3 justify-center">
                {stats.map((item) => (
                  <div class="flex flex-col items-center bg-black/60 backdrop-blur-md p-3 rounded-lg border border-white/10 flex-1">
                    <span class="text-2xl font-bold text-white">{item.value}</span>
                    <span class="text-[10px] uppercase tracking-wider text-slate-400">{item.label}</span>
                  </div>
                ))}
              </div>
            </div>
          )}
        </div>
      </div>
    </div>
  </div>
  <slot />
</section>
