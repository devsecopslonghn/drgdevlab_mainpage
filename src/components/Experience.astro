---
const experiences = [
  {
    id: 'sacombank',
    company: 'Sacombank',
    role: 'DevOps Engineer',
    period: 'Nov 2024 — Present',
    type: 'Current',
    location: 'Ho Chi Minh City',
    domain: 'Core Banking · Open Banking · Payment Systems',
    icon: 'account_balance',
    color: 'primary',
    systems: ['Core T24', 'Open Banking', 'Payment Systems', 'OpenShift OCP'],
    highlights: [
      { icon: 'rocket_launch', text: 'Contributed to enabling Sacombank to become the first bank in Vietnam to go-live on Temenos T24 R25 — total upgrade window reduced from 2 weeks (R17/2017) to 3 days (R25/2026) through pipeline automation and continuous process improvement' },
      { icon: 'hub', text: 'First Temenos T24 deployment on OpenShift at Sacombank — authored Helm umbrella charts for modular, independent upgrades per component (ENQ, WEB channels) with zero cross-component coupling' },
      { icon: 'tune', text: 'Redesigned JBoss domain topology for AML system: split into 2 independent server groups with load balancer reconfiguration, eliminating ~10-minute deployment downtime' },
      { icon: 'fact_check', text: 'Architected branch-based CI/CD strategy with ITSM-gated production deployments — Git tag triggers QA notification email with one-click approval; master merge creates ITSM change ticket for infra-confirmed production release' },
      { icon: 'verified_user', text: 'Integrated security scanning (SonarQube, Aqua Scanner, Coverity, BlackDuck) and Microsoft Teams workflow automation into all pipeline stages' },
      { icon: 'smart_toy', text: 'Managed CI/CD for ~400 source codes across WebSphere, OCP, JBoss; maintained 99% uptime via Grafana, Prometheus, Datadog, Zabbix + Kibana log integration' },
    ],
    metrics: [
      { value: '50%', label: 'Faster deployments' },
      { value: '75%', label: 'More frequent releases' },
      { value: '2w→3d', label: 'T24 upgrade window' },
      { value: '99%', label: 'System uptime' },
    ]
  },
  {
    id: 'accenture',
    company: 'Accenture',
    role: 'Monitoring DevOps Engineer',
    period: 'Jul 2024 — Oct 2024',
    type: 'Previous',
    location: 'Ho Chi Minh City',
    domain: 'Clients: LVMH Louis Vuitton · OVH Cloud',
    icon: 'monitor_heart',
    color: 'blue-400',
    systems: ['Datadog', 'Zabbix'],
    highlights: [
      { icon: 'monitor_heart', text: 'Monitored enterprise infrastructure for LVMH Louis Vuitton and OVH Cloud using Datadog and Zabbix' },
      { icon: 'notification_important', text: 'Built and maintained alert logic pipeline: aggregated incidents from monitoring stack and auto-created structured tickets for partner response teams' },
    ],
    metrics: []
  },
  {
    id: 'dxc',
    company: 'DXC Technology Vietnam',
    role: 'DevOps Engineer',
    period: 'Sep 2022 — Jul 2024',
    type: 'Previous',
    location: 'Ho Chi Minh City',
    domain: 'Clients: Allianz Philippines · AIA · PSMBFI',
    icon: 'corporate_fare',
    color: 'blue-400',
    systems: ['Jenkins', 'GitLab CI', 'Ansible', 'Nexus', 'JFrog'],
    highlights: [
      { icon: 'emoji_events', text: 'Primary DevOps implementer for Allianz Philippines, AIA, PSMBFI on AWS — completed critical platform delivery within 100 days, received formal recognition from Allianz Philippines' },
      { icon: 'savings', text: 'Reduced AWS non-production costs by 40% through instance rightsizing, auto-scaling policies, and spot instance adoption across dev, FT, UAT, and staging environments' },
      { icon: 'build', text: 'Provisioned cloud infrastructure with Terraform; automated configuration management with Ansible and Groovy-based Jenkins pipeline scripts for multi-environment deployments' },
      { icon: 'inventory_2', text: 'Built artifact management workflows with Nexus and JFrog Artifactory; implemented CI/CD compliance gates for regulated financial services clients' },
    ],
    metrics: []
  }
];
---

<section id="experience" class="px-6 py-20 lg:px-20">
  <div class="mx-auto max-w-[1200px]">

    <div class="mb-12 reveal">
      <div class="inline-flex items-center gap-2 rounded-full border border-border-dark bg-surface-dark px-4 py-1.5 font-mono text-xs text-text-muted mb-4">
        <span class="material-symbols-outlined text-sm text-primary">work_history</span>
        experience
      </div>
      <h2 class="text-3xl font-black text-white lg:text-4xl">
        Banking <span class="text-transparent bg-clip-text bg-gradient-to-r from-primary to-emerald-400">Production</span> Experience
      </h2>
    </div>

    <div class="relative">
      <!-- Timeline line -->
      <div class="absolute left-6 top-0 bottom-0 w-px bg-border-dark hidden md:block"></div>

      <div class="flex flex-col gap-8">
        {experiences.map((exp, idx) => (
          <div class={`reveal reveal-delay-${idx + 1} relative md:pl-16`}>
            <!-- Timeline dot -->
            <div class={`absolute left-4 top-8 hidden md:flex h-5 w-5 -translate-x-1/2 items-center justify-center rounded-full border-2 ${exp.color === 'primary' ? 'border-primary bg-primary/20' : 'border-blue-400 bg-blue-400/20'}`}>
              <div class={`h-2 w-2 rounded-full ${exp.color === 'primary' ? 'bg-primary' : 'bg-blue-400'}`}></div>
            </div>

            <div class="rounded-xl border border-border-dark bg-surface-dark overflow-hidden">
              <!-- Header -->
              <div class={`flex flex-wrap items-start justify-between gap-4 p-6 border-b border-border-dark bg-background-dark`}>
                <div class="flex items-start gap-4">
                  <div class={`flex h-12 w-12 flex-shrink-0 items-center justify-center rounded-lg border ${exp.color === 'primary' ? 'border-primary/30 bg-primary/10 text-primary' : 'border-blue-400/30 bg-blue-400/10 text-blue-400'}`}>
                    <span class="material-symbols-outlined">{exp.icon}</span>
                  </div>
                  <div>
                    <div class="flex items-center gap-3 flex-wrap">
                      <h3 class="text-xl font-black text-white">{exp.company}</h3>
                      {exp.type === 'Current' && (
                        <span class="inline-flex items-center gap-1.5 rounded-full border border-primary/20 bg-primary/10 px-3 py-0.5 font-mono text-[10px] font-bold text-primary">
                          <span class="relative flex h-1.5 w-1.5">
                            <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-primary opacity-75"></span>
                            <span class="relative inline-flex rounded-full h-1.5 w-1.5 bg-primary"></span>
                          </span>
                          CURRENT
                        </span>
                      )}
                    </div>
                    <div class="text-text-muted font-mono text-sm mt-0.5">{exp.role}</div>
                    <div class="text-text-muted/60 font-mono text-xs mt-1">{exp.domain}</div>
                  </div>
                </div>
                <div class="text-right">
                  <div class="font-mono text-xs text-text-muted">{exp.period}</div>
                  <div class="font-mono text-xs text-text-muted/60 mt-0.5">{exp.location}</div>
                </div>
              </div>

              <!-- Systems tags -->
              <div class="flex flex-wrap gap-2 px-6 pt-5">
                {exp.systems.map(sys => (
                  <span class={`rounded border ${exp.color === 'primary' ? 'border-primary/20 bg-primary/5 text-primary' : 'border-blue-400/20 bg-blue-400/5 text-blue-400'} px-2.5 py-1 font-mono text-xs`}>{sys}</span>
                ))}
              </div>

              <!-- Highlights -->
              <div class="p-6 grid gap-3 md:grid-cols-2">
                {exp.highlights.map(h => (
                  <div class="flex items-start gap-3 rounded-lg bg-background-dark p-3 border border-border-dark">
                    <span class={`material-symbols-outlined text-base flex-shrink-0 mt-0.5 ${exp.color === 'primary' ? 'text-primary' : 'text-blue-400'}`}>{h.icon}</span>
                    <p class="text-xs font-body text-text-muted leading-relaxed">{h.text}</p>
                  </div>
                ))}
              </div>

              <!-- Metrics (Sacombank only) -->
              {exp.metrics.length > 0 && (
                <div class="border-t border-border-dark px-6 py-5">
                  <div class="font-mono text-[10px] text-text-muted uppercase tracking-wider mb-4">Key Impact Metrics</div>
                  <div class="grid grid-cols-2 gap-3 md:grid-cols-4">
                    {exp.metrics.map(m => (
                      <div class="rounded-lg border border-primary/20 bg-primary/5 p-4 text-center">
                        <div class="text-2xl font-black text-primary">{m.value}</div>
                        <div class="text-xs font-mono text-text-muted mt-1">{m.label}</div>
                      </div>
                    ))}
                  </div>
                </div>
              )}
            </div>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>
