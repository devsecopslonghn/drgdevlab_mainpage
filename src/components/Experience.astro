---
const experiences = [
  {
    id: 'sacombank',
    company: 'Sacombank',
    role: 'DevOps Engineer',
    period: 'Jul 2024 — Present',
    type: 'Current',
    location: 'Ho Chi Minh City',
    domain: 'Core Banking · Open Banking · Payment Systems',
    icon: 'account_balance',
    color: 'primary',
    systems: ['Core T24', 'Open Banking', 'Payment Systems', 'OpenShift OCP'],
    highlights: [
      { icon: 'rocket_launch', text: 'Designed and operated CI/CD pipelines using GitLab CI and Jenkins for Core Banking, Open Banking, and Payment systems' },
      { icon: 'hub', text: 'Managed container orchestration on OpenShift OCP — multi-environment, zero-downtime rolling deployments' },
      { icon: 'storage', text: 'Built automated database CI/CD pipelines with schema migration, version control, and rollback strategies' },
      { icon: 'verified_user', text: 'Strengthened security and compliance controls across all pipeline stages for regulatory adherence' },
      { icon: 'smart_toy', text: 'Automated infrastructure and operations workflows using Ansible playbooks' },
      { icon: 'cloud', text: 'Managed hybrid environments: on-premises data centers + AWS cloud integration' },
    ],
    metrics: [
      { value: '50%', label: 'Faster deployments' },
      { value: '75%', label: 'More frequent releases' },
      { value: '40%', label: 'Cost reduction' },
      { value: '99%', label: 'System uptime' },
    ]
  },
  {
    id: 'dxc',
    company: 'DXC Technology Vietnam',
    role: 'DevOps Engineer',
    period: 'Sep 2022 — Jul 2024',
    type: 'Previous',
    location: 'Ho Chi Minh City',
    domain: 'Enterprise Technology Services',
    icon: 'corporate_fare',
    color: 'blue-400',
    systems: ['Enterprise CI/CD', 'Ansible Automation', 'Container Platforms'],
    highlights: [
      { icon: 'build', text: 'Built and maintained CI/CD pipelines for enterprise banking application deployments' },
      { icon: 'inventory_2', text: 'Managed artifact repositories and Docker container registries for multiple environments' },
      { icon: 'smart_toy', text: 'Automated infrastructure provisioning and configuration management using Ansible' },
      { icon: 'security', text: 'Implemented security scanning and compliance checks in deployment workflows' },
      { icon: 'terminal', text: 'Developed Bash and Groovy scripts for pipeline automation and operational tasks' },
    ],
    metrics: []
  }
];
---

<section id="experience" class="px-6 py-20 lg:px-20">
  <div class="mx-auto max-w-[1200px]">

    <div class="mb-12 reveal">
      <div class="inline-flex items-center gap-2 rounded-full border border-border-dark bg-surface-dark px-4 py-1.5 font-mono text-xs text-text-muted mb-4">
        <span class="material-symbols-outlined text-sm text-primary">work_history</span>
        experience
      </div>
      <h2 class="text-3xl font-black text-white lg:text-4xl">
        Banking <span class="text-transparent bg-clip-text bg-gradient-to-r from-primary to-emerald-400">Production</span> Experience
      </h2>
    </div>

    <div class="relative">
      <!-- Timeline line -->
      <div class="absolute left-6 top-0 bottom-0 w-px bg-border-dark hidden md:block"></div>

      <div class="flex flex-col gap-8">
        {experiences.map((exp, idx) => (
          <div class={`reveal reveal-delay-${idx + 1} relative md:pl-16`}>
            <!-- Timeline dot -->
            <div class={`absolute left-4 top-8 hidden md:flex h-5 w-5 -translate-x-1/2 items-center justify-center rounded-full border-2 ${exp.color === 'primary' ? 'border-primary bg-primary/20' : 'border-blue-400 bg-blue-400/20'}`}>
              <div class={`h-2 w-2 rounded-full ${exp.color === 'primary' ? 'bg-primary' : 'bg-blue-400'}`}></div>
            </div>

            <div class="rounded-xl border border-border-dark bg-surface-dark overflow-hidden">
              <!-- Header -->
              <div class={`flex flex-wrap items-start justify-between gap-4 p-6 border-b border-border-dark bg-[#161f1a]`}>
                <div class="flex items-start gap-4">
                  <div class={`flex h-12 w-12 flex-shrink-0 items-center justify-center rounded-lg border ${exp.color === 'primary' ? 'border-primary/30 bg-primary/10 text-primary' : 'border-blue-400/30 bg-blue-400/10 text-blue-400'}`}>
                    <span class="material-symbols-outlined">{exp.icon}</span>
                  </div>
                  <div>
                    <div class="flex items-center gap-3 flex-wrap">
                      <h3 class="text-xl font-black text-white">{exp.company}</h3>
                      {exp.type === 'Current' && (
                        <span class="inline-flex items-center gap-1.5 rounded-full border border-primary/20 bg-primary/10 px-3 py-0.5 font-mono text-[10px] font-bold text-primary">
                          <span class="relative flex h-1.5 w-1.5">
                            <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-primary opacity-75"></span>
                            <span class="relative inline-flex rounded-full h-1.5 w-1.5 bg-primary"></span>
                          </span>
                          CURRENT
                        </span>
                      )}
                    </div>
                    <div class="text-text-muted font-mono text-sm mt-0.5">{exp.role}</div>
                    <div class="text-text-muted/60 font-mono text-xs mt-1">{exp.domain}</div>
                  </div>
                </div>
                <div class="text-right">
                  <div class="font-mono text-xs text-text-muted">{exp.period}</div>
                  <div class="font-mono text-xs text-text-muted/60 mt-0.5">{exp.location}</div>
                </div>
              </div>

              <!-- Systems tags -->
              <div class="flex flex-wrap gap-2 px-6 pt-5">
                {exp.systems.map(sys => (
                  <span class={`rounded border ${exp.color === 'primary' ? 'border-primary/20 bg-primary/5 text-primary' : 'border-blue-400/20 bg-blue-400/5 text-blue-400'} px-2.5 py-1 font-mono text-xs`}>{sys}</span>
                ))}
              </div>

              <!-- Highlights -->
              <div class="p-6 grid gap-3 md:grid-cols-2">
                {exp.highlights.map(h => (
                  <div class="flex items-start gap-3 rounded-lg bg-[#161f1a] p-3 border border-border-dark">
                    <span class={`material-symbols-outlined text-base flex-shrink-0 mt-0.5 ${exp.color === 'primary' ? 'text-primary' : 'text-blue-400'}`}>{h.icon}</span>
                    <p class="text-xs font-body text-text-muted leading-relaxed">{h.text}</p>
                  </div>
                ))}
              </div>

              <!-- Metrics (Sacombank only) -->
              {exp.metrics.length > 0 && (
                <div class="border-t border-border-dark px-6 py-5">
                  <div class="font-mono text-[10px] text-text-muted uppercase tracking-wider mb-4">Key Impact Metrics</div>
                  <div class="grid grid-cols-2 gap-3 md:grid-cols-4">
                    {exp.metrics.map(m => (
                      <div class="rounded-lg border border-primary/20 bg-primary/5 p-4 text-center">
                        <div class="text-2xl font-black text-primary">{m.value}</div>
                        <div class="text-xs font-mono text-text-muted mt-1">{m.label}</div>
                      </div>
                    ))}
                  </div>
                </div>
              )}
            </div>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>
