---

<section id="skills" class="px-6 py-20 lg:px-20 bg-surface-dark/20">
  <div class="mx-auto max-w-[1200px]">

    <div class="mb-10 reveal">
      <div class="inline-flex items-center gap-2 rounded-full border border-border-dark bg-surface-dark px-4 py-1.5 font-mono text-xs text-text-muted mb-4">
        <span class="material-symbols-outlined text-sm text-primary">psychology</span>
        skills
      </div>
      <h2 class="text-2xl font-black text-white lg:text-3xl">
        Technical <span class="text-transparent bg-clip-text bg-gradient-to-r from-primary to-emerald-400">Capabilities</span>
      </h2>
      <!-- Color legend -->
      <div class="flex flex-wrap gap-x-5 gap-y-1.5 mt-4">
        {[
          { color: 'bg-primary', label: 'Pipeline & Infrastructure' },
          { color: 'bg-cyan-400', label: 'Observability' },
          { color: 'bg-amber-400', label: 'Domain Expertise' },
          { color: 'bg-red-400', label: 'Security & Compliance' },
        ].map(l => (
          <div class="flex items-center gap-1.5 font-mono text-[10px] text-text-muted/60">
            <div class={`w-1.5 h-1.5 rounded-full ${l.color} opacity-70`}></div>
            {l.label}
          </div>
        ))}
      </div>
    </div>

    <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4">
      {skillGroups.map((group, gi) => (
        <div class={`reveal reveal-delay-${(gi % 3) + 1} rounded-xl border border-border-dark bg-[#161f1a] p-5 hover:border-opacity-40 transition-all duration-200`}
             style={`--hover-border: var(--tw-border-opacity)`}>
          <div class="flex items-center gap-3 mb-4">
            <div class={`flex h-8 w-8 items-center justify-center rounded-lg border ${group.border} ${group.bg}`}>
              <span class={`material-symbols-outlined text-sm ${group.color}`}>{group.icon}</span>
            </div>
            <h3 class="font-bold text-white text-xs">{group.title}</h3>
          </div>
          <div class="space-y-3">
            {group.skills.map(skill => (
              <div>
                <div class="flex justify-between items-center mb-1">
                  <span class="font-mono text-[10px] text-text-muted">{skill.name}</span>
                  <span class={`font-mono text-[9px] ${group.color} opacity-80`}>{skill.level}%</span>
                </div>
                <div class="h-1 w-full rounded-full bg-border-dark overflow-hidden">
                  <div
                    class={`h-full rounded-full skill-bar ${group.bg.replace('bg-', 'skill-fill-')}`}
                    data-width={skill.level}
                    data-color={group.color}
                    style="width: 0%"
                  ></div>
                </div>
              </div>
            ))}
          </div>
        </div>
      ))}
    </div>

    <!-- Tools grid -->
    <div class="mt-10 reveal">
      <div class="font-mono text-xs text-text-muted mb-4 uppercase tracking-wider">All Tools & Technologies</div>
      <div class="flex flex-wrap gap-2">
        {[
          'Jenkins', 'GitLab CI', 'OpenShift OCP', 'Kubernetes', 'Docker', 'Ansible',
          'AWS EC2', 'AWS S3', 'AWS Lambda', 'AWS RDS', 'AWS ECS', 'API Gateway',
          'Core T24', 'Open Banking', 'Payment Systems', 'WebSphere', 'JBoss',
          'Bash', 'Groovy', 'Python', 'Flyway', 'Nexus', 'JFrog', 'Helm',
          'Grafana', 'Prometheus', 'Datadog', 'Zabbix',
          'SonarQube', 'Aqua Scanner', 'Coverity', 'BlackDuck',
          'Git', 'Linux', 'Nginx', 'Oracle DB', 'PostgreSQL'
        ].map(tool => (
          <span class="rounded border border-border-dark bg-surface-dark px-3 py-1.5 font-mono text-xs text-text-muted hover:border-primary/30 hover:text-primary transition-colors cursor-default">{tool}</span>
        ))}
      </div>
    </div>

  </div>
</section>

<script>
  const COLOR_MAP: Record<string, string> = {
    'text-primary':   '#13ec80',
    'text-cyan-400':  '#22d3ee',
    'text-amber-400': '#fbbf24',
    'text-red-400':   '#f87171',
  };

  const bars = document.querySelectorAll<HTMLElement>('.skill-bar');
  const skillObserver = new IntersectionObserver(
    (entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          const bar = entry.target as HTMLElement;
          const width = bar.dataset.width;
          const colorClass = bar.dataset.color ?? 'text-primary';
          const hex = COLOR_MAP[colorClass] ?? '#13ec80';
          setTimeout(() => {
            bar.style.width = width + '%';
            bar.style.transition = 'width 1s cubic-bezier(0.4, 0, 0.2, 1)';
            bar.style.background = `linear-gradient(90deg, ${hex}cc, ${hex}66)`;
          }, 100);
          skillObserver.unobserve(bar);
        }
      });
    },
    { threshold: 0.1 }
  );
  bars.forEach((bar) => skillObserver.observe(bar));
</script>
