---
const { title = '', items = [] } = Astro.props;
---

<section class="border-y border-slate-200 dark:border-surface-border bg-white dark:bg-surface-dark/50 py-10">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    {title && <p class="text-center text-sm font-semibold text-slate-500 dark:text-slate-400 uppercase tracking-widest mb-8">{title}</p>}
    <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-5 gap-6">
      {items.map((item) => (
        <div class="flex flex-col items-center gap-3 p-4 rounded-lg hover:bg-background-light dark:hover:bg-surface-border/50 transition-colors group cursor-default">
          <span class={`material-symbols-outlined text-4xl text-slate-700 dark:text-slate-300 transition-colors ${item.color ?? ''}`}>
            {item.icon}
          </span>
          <span class="text-sm font-bold text-slate-700 dark:text-slate-200">{item.label}</span>
        </div>
      ))}
    </div>
  </div>
</section>
