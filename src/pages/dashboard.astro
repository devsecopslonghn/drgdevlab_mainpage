</BaseLayout>

<style>
  .status-pulse {
    box-shadow: 0 0 0 0 rgba(19, 236, 128, 0.7);
    animation: pulse-green 2s infinite;
  }

  @keyframes pulse-green {
    0% {
      transform: scale(0.95);
      box-shadow: 0 0 0 0 rgba(19, 236, 128, 0.7);
    }
    70% {
      transform: scale(1);
      box-shadow: 0 0 0 6px rgba(19, 236, 128, 0);
    }
    100% {
      transform: scale(0.95);
      box-shadow: 0 0 0 0 rgba(19, 236, 128, 0);
    }
  }
</style>

<script>
  const statusThemes = {
    online: {
      label: 'Online',
      badge: 'border-primary/20 bg-primary/5 text-primary',
      dot: 'bg-primary',
      ping: 'animate-ping bg-primary',
      card: 'hover:border-primary/50 hover:bg-surface-dark hover:shadow-lg hover:shadow-primary/5'
    },
    offline: {
      label: 'Offline',
      badge: 'border-red-500/30 bg-red-500/10 text-red-300',
      dot: 'bg-red-500',
      ping: '',
      card: 'hover:border-red-500/50 hover:bg-surface-dark hover:shadow-lg hover:shadow-red-500/5'
    },
    checking: {
      label: 'Checking',
      badge: 'border-border-dark bg-surface-dark text-text-muted',
      dot: 'bg-border-dark',
      ping: 'animate-ping bg-border-dark',
      card: 'hover:border-border-dark hover:bg-surface-dark/70'
    }
  };

  async function pingUrl(url, timeoutMs = 7000) {
    const controller = new AbortController();
    const timer = setTimeout(() => controller.abort(), timeoutMs);
    try {
      // no-cors để tránh chặn CORS; chỉ cần request thành công là coi như online
      await fetch(url, { method: 'GET', mode: 'no-cors', cache: 'no-store', signal: controller.signal });
      return true;
    } catch (err) {
      return false;
    } finally {
      clearTimeout(timer);
    }
  }

  function applyState(card, state) {
    const theme = statusThemes[state] ?? statusThemes.checking;
    const badge = card.querySelector('[data-badge]');
    const dotWrap = card.querySelector('[data-dot-wrap]');
    const dot = card.querySelector('[data-dot]');
    const label = card.querySelector('[data-label]');

    label.textContent = theme.label;
    badge.className = `flex items-center gap-2 rounded-full border ${theme.badge} px-2.5 py-1 backdrop-blur-sm`;
    dot.className = `relative inline-flex rounded-full h-1.5 w-1.5 ${theme.dot}`;

    dotWrap.querySelectorAll('[data-ping]').forEach((node) => node.remove());
    if (theme.ping) {
      const ping = document.createElement('span');
      ping.className = `absolute inline-flex h-full w-full rounded-full opacity-75 ${theme.ping}`;
      ping.setAttribute('data-ping', '');
      dotWrap.prepend(ping);
    }

    const base = card.dataset.baseClass ?? '';
    card.className = `${base} ${theme.card}`;
    card.dataset.state = state;
  }

  async function refreshStatuses() {
    const cards = Array.from(document.querySelectorAll('[data-service-card]'));
    const requests = cards.map(async (card) => {
      const ping = card.dataset.ping;
      if (!ping) return;
      applyState(card, 'checking');
      const ok = await pingUrl(ping);
      applyState(card, ok ? 'online' : 'offline');
    });
    await Promise.allSettled(requests);
  }

  window.addEventListener('load', () => {
    refreshStatuses();
    setInterval(refreshStatuses, 30000);
  });
</script>
