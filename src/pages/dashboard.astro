>
  <div class="relative flex h-auto min-h-screen w-full flex-col overflow-x-hidden bg-background-dark text-white font-display">
    <header class="sticky top-0 z-50 flex w-full items-center justify-between border-b border-border-dark bg-background-dark/95 backdrop-blur-sm px-6 py-4 lg:px-20">
