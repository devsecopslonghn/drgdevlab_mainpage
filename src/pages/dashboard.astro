  online: {
    label: 'Online',
    cardHover: 'hover:border-primary/50 hover:bg-surface-dark hover:shadow-lg hover:shadow-primary/5',
    badge: 'border-primary/20 bg-primary/5 text-primary',
    dot: 'bg-primary',
    ping: 'animate-ping bg-primary'
