                  <div class="mb-3 flex items-center gap-2 text-primary">
                    <span class="material-symbols-outlined text-lg">{stack.icon}</span>
                    <h4 class="text-sm font-bold uppercase tracking-wide">{stack.title}</h4>
                  </div>
                  <div class="flex flex-wrap gap-2">
                    {stack.items.map((item) => (
                      <span class="rounded bg-background-dark px-2 py-1 text-xs font-mono text-text-muted border border-border-dark">{item}</span>
                    ))}
