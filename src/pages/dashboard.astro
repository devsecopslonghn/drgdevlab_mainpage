                    </li>
                    <li class="flex items-center gap-2">
                      <span class="material-symbols-outlined text-[14px]">check</span> High Availability Clusters
                    </li>
                    <li class="flex items-center gap-2">
                      <span class="material-symbols-outlined text-[14px]">check</span> Cost Optimization
                    </li>
                  </ul>
                </div>
              </div>
            </div>
          </div>
          <div class="lg:col-span-7 flex flex-col">
            <div class="mb-6 flex items-center gap-3 border-b border-border-dark pb-4">
              <h3 class="text-xl font-bold text-white">Tech Stack & Capabilities</h3>
            </div>
            <div class="grid gap-4 sm:grid-cols-2">
              {techStacks.map((stack) => (
