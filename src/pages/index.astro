---
import BaseLayout from '@layouts/BaseLayout.astro';
import Navbar from '@components/Navbar.astro';
import Contact from '@components/Contact.astro';
import Footer from '@components/Footer.astro';

const proofPoints = [
  { value: '4 years', label: 'DevOps / DevSecOps', note: 'Banking, insurance & enterprise' },
  { value: '~400 repos', label: 'CI/CD estate', note: 'OpenShift, WebSphere, JBoss & more' },
  { value: 'T24 R25', label: 'Production modernization', note: 'First successful upgrade in Vietnam' },
  { value: 'Jenkins OSS', label: 'Plugin maintainer', note: 'jenkinsci/ansible-tower-plugin' },
];

const pillars = [
  { icon: 'account_tree', title: 'CI/CD Platform Engineering', text: 'Reusable Jenkins/Groovy pipelines, GitLab CI and GitHub Actions for multi-stack delivery, release governance, artifact promotion and developer enablement.' },
  { icon: 'shield_lock', title: 'Secure Software Delivery', text: 'Security gates across SAST, SCA, container scanning, DAST and quality controls, with auditability and approval workflows built into the release path.' },
  { icon: 'deployed_code', title: 'Release & Availability Engineering', text: 'Rolling, canary and blue-green strategies for containers, plus controlled node-by-node rollout patterns for clustered WebSphere and JBoss workloads.' },
  { icon: 'dns', title: 'Platform & Infrastructure', text: 'OpenShift/Kubernetes, Helm, Argo CD, Ansible, Terraform and AWS infrastructure for regulated, production-critical systems.' },
];

const featured = [
  {
    eyebrow: 'CORE BANKING',
    title: 'Temenos T24 R25 Platform Delivery',
    text: 'Contributed to Sacombank\'s successful Temenos T24 R25 production upgrade, the first successful T24 R25 core banking upgrade in Vietnam.',
    tags: ['Temenos T24 R25', 'OpenShift', 'Helm', 'CI/CD', 'Release Engineering'],
    facts: ['18 workloads', '6 environments', 'Umbrella Helm architecture'],
    href: 'https://www.sacombank.com.vn/trang-chu/tin-tuc/tin-sacombank/2026/sacombank-nang-cap-thanh-cong-core-banking-t24-r25-moi-nhat-toan-cau.html',
    cta: 'Official announcement'
  },
  {
    eyebrow: 'PLATFORM ENGINEERING',
    title: 'Enterprise CI/CD Platform',
    text: 'Designing reusable delivery patterns for approximately 400 source repositories across containerized microservices and traditional middleware platforms.',
    tags: ['Jenkins', 'Groovy', 'GitLab', 'Ansible', 'Nexus', 'DevSecOps'],
    facts: ['~400 repositories', 'Multi-language', 'DEV → PROD governance'],
    href: '/experience',
    cta: 'View platform experience'
  },
  {
    eyebrow: 'OPEN SOURCE',
    title: 'Jenkins Ansible Tower Plugin',
    text: 'Maintaining the Jenkins integration with Ansible Tower, AWX and Ansible Automation Platform, with recent work across reliability, compatibility, diagnostics and security.',
    tags: ['Jenkins', 'Java', 'AAP/AWX', 'Open Source'],
    facts: ['Polling resilience', 'Job DSL compatibility', 'Security & regression testing'],
    href: 'https://github.com/jenkinsci/ansible-tower-plugin',
    cta: 'View on GitHub'
  },
];

const stack = [
  ['CI/CD', 'Jenkins · GitLab CI · GitHub Actions · Groovy'],
  ['Platform', 'Kubernetes · OpenShift · Helm · Argo CD'],
  ['Security', 'Coverity · Black Duck · Aqua · SonarQube · OWASP ZAP'],
  ['Automation', 'Ansible · Terraform · Python · Bash · PowerShell'],
  ['Cloud & Observability', 'AWS · Prometheus · Grafana · Datadog · Kibana'],
  ['Middleware & Banking', 'Temenos T24 · WebSphere · JBoss · WebLogic · WSO2'],
];
---

<BaseLayout
  title="Long Ho — DevSecOps & CI/CD Platform Engineer"
  description="DevSecOps and CI/CD Platform Engineer with experience in Temenos T24 R25, Jenkins open-source plugin maintenance, Kubernetes/OpenShift, AWS/Terraform and secure software delivery."
>
  <div class="relative min-h-screen bg-background-dark text-white font-display overflow-x-hidden">
    <Navbar />
    <main>
      <section class="relative px-6 py-16 lg:px-20 lg:py-24 overflow-hidden">
        <div class="pointer-events-none absolute inset-0 bg-[linear-gradient(to_right,#283930_1px,transparent_1px),linear-gradient(to_bottom,#283930_1px,transparent_1px)] bg-[size:56px_56px] opacity-[0.05]"></div>
        <div class="relative mx-auto max-w-[1200px] grid gap-12 lg:grid-cols-[1.3fr_.7fr] lg:gap-16 items-start">
          <div>
            <div class="font-mono text-xs uppercase tracking-[0.2em] text-primary mb-5">DevSecOps · Platform · Release Engineering</div>
            <h1 class="text-5xl font-black leading-[1.03] tracking-tight text-white md:text-6xl xl:text-7xl">Long Ho</h1>
            <h2 class="mt-4 text-2xl font-bold text-white/90 md:text-3xl">DevSecOps & CI/CD Platform Engineer</h2>
            <p class="mt-3 font-mono text-sm text-text-muted">Banking Platforms · Jenkins · Kubernetes/OpenShift · Secure Software Delivery</p>
            <p class="mt-7 max-w-[700px] text-lg font-body leading-relaxed text-text-muted">
              I design and operate secure delivery platforms for regulated, production-critical systems — from reusable CI/CD and DevSecOps controls to Kubernetes/OpenShift delivery, release availability patterns and cloud infrastructure.
            </p>
            <div class="mt-8 flex flex-wrap gap-3">
              <a href="/experience" class="inline-flex h-12 items-center gap-2 rounded-lg bg-primary px-6 text-sm font-bold text-background-dark hover:bg-primary-hover transition-colors">
                <span class="material-symbols-outlined text-base">work</span>View Experience
              </a>
              <a href="https://github.com/jenkinsci/ansible-tower-plugin" target="_blank" rel="noreferrer" class="inline-flex h-12 items-center gap-2 rounded-lg border border-border-dark bg-surface-dark px-6 text-sm font-bold text-white hover:border-primary/40 hover:text-primary transition-colors">
                <span class="material-symbols-outlined text-base">code</span>Open Source Work
              </a>
            </div>
          </div>

          <aside class="rounded-2xl border border-border-dark bg-surface-dark overflow-hidden shadow-2xl shadow-black/20">
            <div class="border-b border-border-dark bg-background-dark/70 px-5 py-4">
              <div class="font-mono text-[11px] uppercase tracking-[0.18em] text-text-muted">Professional Profile</div>
            </div>
            <div class="p-5 space-y-5 text-sm">
              <div>
                <div class="font-mono text-[10px] uppercase tracking-wider text-primary">Current</div>
                <div class="mt-1 font-bold text-white">DevOps Engineer · Sacombank</div>
                <div class="mt-1 text-xs text-text-muted">Core Banking · Open Banking · Payment Systems</div>
              </div>
              <div class="border-t border-border-dark pt-5">
                <div class="font-mono text-[10px] uppercase tracking-wider text-primary">Focus</div>
                <div class="mt-2 grid gap-2 text-text-muted">
                  <span>CI/CD Platform Engineering</span><span>Temenos T24 & Core Banking Delivery</span><span>Kubernetes / OpenShift / Helm</span><span>Release & Availability Engineering</span>
                </div>
              </div>
              <div class="border-t border-border-dark pt-5">
                <div class="font-mono text-[10px] uppercase tracking-wider text-primary">Open Source</div>
                <a href="https://github.com/jenkinsci/ansible-tower-plugin" target="_blank" rel="noreferrer" class="mt-2 block font-bold text-white hover:text-primary transition-colors">Jenkins Ansible Tower Plugin ↗</a>
                <div class="mt-1 text-xs text-text-muted">Maintainer · Jenkins project</div>
              </div>
              <div class="border-t border-border-dark pt-5">
                <div class="font-mono text-[10px] uppercase tracking-wider text-primary">Location</div>
                <div class="mt-1 text-text-muted">Ho Chi Minh City, Vietnam</div>
              </div>
            </div>
          </aside>
        </div>
      </section>

      <section class="border-y border-border-dark bg-surface-dark/40 px-6 lg:px-20">
        <div class="mx-auto max-w-[1200px] grid grid-cols-2 lg:grid-cols-4">
          {proofPoints.map((item, index) => (
            <div class:list={['py-7', index % 2 === 0 ? 'pr-5' : 'pl-5', 'lg:px-6', index > 0 ? 'lg:border-l lg:border-border-dark' : '']}>
              <div class="text-2xl font-black text-white">{item.value}</div>
              <div class="mt-1 text-sm font-semibold text-primary">{item.label}</div>
              <div class="mt-1 text-xs font-body text-text-muted">{item.note}</div>
            </div>
          ))}
        </div>
      </section>

      <section class="px-6 py-20 lg:px-20">
        <div class="mx-auto max-w-[1200px]">
          <div class="max-w-2xl mb-10">
            <div class="font-mono text-xs uppercase tracking-[0.18em] text-primary">Engineering identity</div>
            <h2 class="mt-3 text-3xl font-black text-white lg:text-4xl">What I engineer</h2>
            <p class="mt-3 text-text-muted font-body">The same engineering principles across modern container platforms, traditional middleware and regulated delivery environments.</p>
          </div>
          <div class="grid gap-5 md:grid-cols-2">
            {pillars.map(item => (
              <article class="rounded-xl border border-border-dark bg-surface-dark p-6">
                <span class="material-symbols-outlined text-primary">{item.icon}</span>
                <h3 class="mt-4 text-lg font-bold text-white">{item.title}</h3>
                <p class="mt-2 text-sm leading-relaxed text-text-muted">{item.text}</p>
              </article>
            ))}
          </div>
        </div>
      </section>

      <section class="border-y border-border-dark bg-surface-dark/25 px-6 py-20 lg:px-20">
        <div class="mx-auto max-w-[1200px]">
          <div class="mb-10">
            <div class="font-mono text-xs uppercase tracking-[0.18em] text-primary">Selected engineering work</div>
            <h2 class="mt-3 text-3xl font-black text-white lg:text-4xl">Evidence over buzzwords</h2>
          </div>
          <div class="grid gap-6 lg:grid-cols-3">
            {featured.map(item => (
              <article class="flex flex-col rounded-xl border border-border-dark bg-surface-dark overflow-hidden">
                <div class="p-6 flex-1">
                  <div class="font-mono text-[10px] font-bold uppercase tracking-[0.16em] text-primary">{item.eyebrow}</div>
                  <h3 class="mt-3 text-xl font-black text-white">{item.title}</h3>
                  <p class="mt-3 text-sm leading-relaxed text-text-muted">{item.text}</p>
                  <div class="mt-5 flex flex-wrap gap-2">{item.tags.map(tag => <span class="rounded border border-border-dark bg-background-dark px-2.5 py-1 font-mono text-[11px] text-text-muted">{tag}</span>)}</div>
                  <ul class="mt-5 space-y-2 text-xs text-text-muted">{item.facts.map(fact => <li class="flex items-center gap-2"><span class="text-primary">✓</span>{fact}</li>)}</ul>
                </div>
                <a href={item.href} target={item.href.startsWith('http') ? '_blank' : undefined} rel={item.href.startsWith('http') ? 'noreferrer' : undefined} class="border-t border-border-dark px-6 py-4 font-mono text-xs font-bold text-primary hover:bg-primary/5 transition-colors">{item.cta} ↗</a>
              </article>
            ))}
          </div>
        </div>
      </section>

      <section class="px-6 py-20 lg:px-20">
        <div class="mx-auto max-w-[1200px] grid gap-12 lg:grid-cols-[.8fr_1.2fr]">
          <div>
            <div class="font-mono text-xs uppercase tracking-[0.18em] text-primary">Career snapshot</div>
            <h2 class="mt-3 text-3xl font-black text-white">Production accountability</h2>
            <p class="mt-3 text-sm leading-relaxed text-text-muted">Experience spans banking, insurance and enterprise operations, with a consistent focus on secure automation, release safety and platform reliability.</p>
          </div>
          <div class="space-y-0 border-l border-border-dark">
            {[
              ['2024 — Present', 'Sacombank', 'DevOps Engineer', 'Core Banking · Open Banking · Payment Systems'],
              ['2024', 'Accenture', 'Monitoring DevOps Engineer', 'LVMH Louis Vuitton · OVH Cloud'],
              ['2022 — 2024', 'DXC Technology Vietnam', 'DevOps Engineer', 'AWS · Terraform · CI/CD · Financial Services'],
            ].map(row => (
              <div class="relative border-b border-border-dark px-6 py-5">
                <span class="absolute -left-[5px] top-7 h-2.5 w-2.5 rounded-full bg-primary"></span>
                <div class="font-mono text-[11px] text-text-muted">{row[0]}</div>
                <div class="mt-1 font-bold text-white">{row[1]} · {row[2]}</div>
                <div class="mt-1 text-xs text-text-muted">{row[3]}</div>
              </div>
            ))}
          </div>
        </div>
      </section>

      <section class="border-y border-border-dark bg-surface-dark/25 px-6 py-20 lg:px-20">
        <div class="mx-auto max-w-[1200px]">
          <div class="mb-8">
            <div class="font-mono text-xs uppercase tracking-[0.18em] text-primary">Technical stack</div>
            <h2 class="mt-3 text-3xl font-black text-white">Tools in context</h2>
          </div>
          <div class="grid gap-x-12 gap-y-5 md:grid-cols-2">
            {stack.map(item => (
              <div class="border-b border-border-dark pb-4">
                <div class="text-sm font-bold text-white">{item[0]}</div>
                <div class="mt-1 font-mono text-xs leading-relaxed text-text-muted">{item[1]}</div>
              </div>
            ))}
          </div>
        </div>
      </section>

      <Contact />
    </main>
    <Footer />
  </div>
</BaseLayout>
