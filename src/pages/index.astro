---
import BaseLayout from '@layouts/BaseLayout.astro';
import Navbar from '@components/Navbar.astro';
import Contact from '@components/Contact.astro';
import Footer from '@components/Footer.astro';

const proof = [
  ['4 years', 'DevOps / DevSecOps', 'Banking, insurance, enterprise'],
  ['~400 repos', 'CI/CD estate', 'OpenShift, WebSphere, JBoss and more'],
  ['T24 R25', 'Core banking modernization', 'Production upgrade contributor'],
  ['Jenkins OSS', 'Plugin maintainer', 'Ansible Tower / AWX / AAP integration'],
];

const work = [
  {
    number: '01',
    category: 'Core banking modernization',
    title: 'Temenos T24 R25 delivery platform',
    summary: 'CI/CD, OpenShift and Helm delivery work supporting Sacombank\'s successful T24 R25 production upgrade — the first successful T24 R25 core banking upgrade in Vietnam.',
    evidence: ['18 component/workload charts', '6 delivery environments', 'Umbrella Helm architecture'],
    href: '/projects#t24'
  },
  {
    number: '02',
    category: 'Platform engineering',
    title: 'Enterprise CI/CD platform at scale',
    summary: 'Reusable Jenkins/Groovy delivery patterns supporting approximately 400 source repositories across OpenShift microservices and traditional middleware platforms.',
    evidence: ['~400 repositories', 'Multi-language delivery', 'Security and approval gates'],
    href: '/projects#cicd'
  },
  {
    number: '03',
    category: 'Open source',
    title: 'Jenkins Ansible Tower Plugin',
    summary: 'Maintaining the Jenkins integration with Ansible Tower, AWX and Ansible Automation Platform, with work across compatibility, reliability, diagnostics and security.',
    evidence: ['Jenkins/JDK compatibility', 'Workflow polling resilience', 'Job DSL and regression testing'],
    href: 'https://github.com/jenkinsci/ansible-tower-plugin'
  },
];

const capabilities = [
  ['CI/CD Platform Engineering', 'Reusable Jenkins/Groovy pipelines, GitLab CI, GitHub Actions, release governance, artifact promotion and multi-environment delivery.'],
  ['Release & Availability Engineering', 'Rolling, canary and blue-green delivery for containers, plus controlled node-by-node rollout for WebSphere and JBoss clusters.'],
  ['Secure Software Delivery', 'SAST, SCA, image scanning, DAST, automated tests, approval gates and auditable production release controls.'],
  ['Platform & Infrastructure', 'Kubernetes/OpenShift, Helm, Argo CD, Ansible, Terraform, AWS, observability and enterprise middleware.'],
];
---

<BaseLayout
  title="Long Ho — DevSecOps & CI/CD Platform Engineer"
  description="DevSecOps and CI/CD Platform Engineer working across core banking modernization, enterprise CI/CD, Kubernetes/OpenShift, release engineering, and Jenkins open source."
>
  <div class="min-h-screen bg-background-dark text-white">
    <Navbar />

    <main>
      <section class="site-shell pb-20 pt-20 md:pb-24 md:pt-28 lg:pt-32">
        <div class="grid gap-14 lg:grid-cols-[minmax(0,1.35fr)_minmax(300px,.65fr)] lg:items-end">
          <div>
            <div class="eyebrow">Long Ho · Ho Chi Minh City, Vietnam</div>
            <h1 class="mt-5 max-w-4xl text-5xl font-semibold tracking-[-0.055em] text-white md:text-6xl lg:text-[72px] lg:leading-[1.02]">
              DevSecOps & CI/CD Platform Engineer
            </h1>
            <p class="mt-7 max-w-3xl text-lg leading-8 text-text-muted md:text-xl">
              I design secure delivery platforms for regulated, production-critical systems — spanning core banking, Kubernetes/OpenShift, release engineering, cloud infrastructure, and Jenkins open source.
            </p>
            <div class="mt-9 flex flex-wrap gap-3">
              <a href="/projects" class="rounded-lg bg-white px-5 py-3 text-sm font-semibold text-black transition-opacity hover:opacity-90">View selected work</a>
              <a href="/experience" class="rounded-lg border border-border-dark px-5 py-3 text-sm font-medium text-white hover:border-primary/40">Experience</a>
            </div>
          </div>

          <aside class="border-l border-border-dark pl-6 lg:pl-8">
            <div class="eyebrow">Current focus</div>
            <dl class="mt-5 space-y-5">
              <div>
                <dt class="text-xs text-text-subtle">Role</dt>
                <dd class="mt-1 text-sm font-medium text-white">DevOps Engineer · Sacombank</dd>
              </div>
              <div>
                <dt class="text-xs text-text-subtle">Engineering</dt>
                <dd class="mt-1 text-sm leading-6 text-text-muted">CI/CD platforms · Release availability · Kubernetes/OpenShift · Core Banking</dd>
              </div>
              <div>
                <dt class="text-xs text-text-subtle">Open source</dt>
                <dd class="mt-1 text-sm leading-6">
                  <a href="https://github.com/jenkinsci/ansible-tower-plugin" target="_blank" rel="noreferrer" class="accent-link">Jenkins Ansible Tower Plugin ↗</a>
                </dd>
              </div>
            </dl>
          </aside>
        </div>
      </section>

      <section class="border-y border-border-dark">
        <div class="site-shell grid sm:grid-cols-2 lg:grid-cols-4">
          {proof.map((item, index) => (
            <div class:list={['py-7', 'lg:py-8', index > 0 ? 'lg:border-l lg:border-border-dark lg:pl-6' : '', index < 3 ? 'sm:border-b sm:border-border-dark lg:border-b-0' : '']}>
              <div class="text-xl font-semibold tracking-[-0.03em] text-white">{item[0]}</div>
              <div class="mt-1 text-sm font-medium text-primary">{item[1]}</div>
              <div class="mt-1 text-xs leading-5 text-text-subtle">{item[2]}</div>
            </div>
          ))}
        </div>
      </section>

      <section class="section-space">
        <div class="site-shell">
          <div class="max-w-2xl">
            <div class="eyebrow">Selected engineering work</div>
            <h2 class="section-title">Proof before tooling.</h2>
            <p class="section-copy">The work I want to be evaluated on: platform scale, production responsibility, and engineering decisions that improve release safety.</p>
          </div>

          <div class="mt-12 border-t border-border-dark">
            {work.map(item => (
              <article class="grid gap-5 border-b border-border-dark py-8 md:grid-cols-[70px_1.05fr_1.2fr] md:gap-8 md:py-10">
                <div class="font-mono text-xs text-text-subtle">{item.number}</div>
                <div>
                  <div class="eyebrow">{item.category}</div>
                  <h3 class="mt-2 text-xl font-semibold tracking-[-0.025em] text-white md:text-2xl">{item.title}</h3>
                </div>
                <div>
                  <p class="text-sm leading-7 text-text-muted">{item.summary}</p>
                  <div class="mt-4 flex flex-wrap gap-x-5 gap-y-2 text-xs text-text-subtle">
                    {item.evidence.map(e => <span>{e}</span>)}
                  </div>
                  <a href={item.href} target={item.href.startsWith('http') ? '_blank' : undefined} rel={item.href.startsWith('http') ? 'noreferrer' : undefined} class="mt-5 inline-block text-sm font-medium text-white hover:text-primary">
                    Read case study ↗
                  </a>
                </div>
              </article>
            ))}
          </div>
        </div>
      </section>

      <section class="border-y border-border-dark bg-surface-dark/30">
        <div class="site-shell section-space">
          <div class="grid gap-12 lg:grid-cols-[.7fr_1.3fr]">
            <div>
              <div class="eyebrow">Engineering profile</div>
              <h2 class="section-title">What I am actually responsible for.</h2>
            </div>
            <div class="grid gap-x-10 gap-y-0 md:grid-cols-2">
              {capabilities.map((item, index) => (
                <div class:list={['border-t border-border-dark py-6', index > 1 ? 'md:border-b' : '']}>
                  <h3 class="text-base font-semibold text-white">{item[0]}</h3>
                  <p class="mt-2 text-sm leading-6 text-text-muted">{item[1]}</p>
                </div>
              ))}
            </div>
          </div>
        </div>
      </section>

      <section class="section-space">
        <div class="site-shell grid gap-12 lg:grid-cols-[.85fr_1.15fr]">
          <div>
            <div class="eyebrow">Open source engineering</div>
            <h2 class="section-title">Maintaining software people depend on.</h2>
            <p class="section-copy">Public engineering work is a useful counterweight to private enterprise experience: the code, reviews and compatibility decisions are visible.</p>
          </div>
          <div class="border-t border-border-dark">
            {[
              ['Repository', 'jenkinsci/ansible-tower-plugin'],
              ['Scope', 'Jenkins integration for Ansible Tower, AWX and Ansible Automation Platform'],
              ['Recent focus', 'Workflow polling resilience · diagnostics · Job DSL compatibility · Jenkins/JDK baselines · security scanning · regression coverage'],
            ].map(row => (
              <div class="grid gap-2 border-b border-border-dark py-5 sm:grid-cols-[130px_1fr]">
                <div class="text-xs text-text-subtle">{row[0]}</div>
                <div class="text-sm leading-6 text-text-muted">{row[1]}</div>
              </div>
            ))}
            <a href="https://github.com/jenkinsci/ansible-tower-plugin" target="_blank" rel="noreferrer" class="mt-6 inline-flex items-center gap-2 text-sm font-medium text-white hover:text-primary">
              View repository <span aria-hidden="true">↗</span>
            </a>
          </div>
        </div>
      </section>

      <Contact />
    </main>

    <Footer />
  </div>
</BaseLayout>
