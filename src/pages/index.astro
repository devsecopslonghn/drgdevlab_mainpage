---
import BaseLayout from '@layouts/BaseLayout.astro';
import Hero from '@components/Hero.astro';
import TechGrid from '@components/TechGrid.astro';

const techItems = [
  { icon: 'cloud_queue', label: 'AWS', color: 'group-hover:text-[#FF9900]' },
  { icon: 'view_in_ar', label: 'Kubernetes', color: 'group-hover:text-[#326CE5]' },
  { icon: 'deployed_code', label: 'Terraform', color: 'group-hover:text-[#7B42BC]' },
  { icon: 'layers', label: 'Docker', color: 'group-hover:text-[#2496ED]' },
  { icon: 'terminal', label: 'Python', color: 'group-hover:text-[#3776AB]' }
];
---

<BaseLayout title="DevOps Engineer Portfolio" description="Giới thiệu cá nhân và kỹ năng DevOps">
  <Hero
    badge="Hello, I'm"
    name="Alex"
    role="DevOps"
    highlight="Engineer"
    description="Bridging the gap between development and operations với 3 năm kinh nghiệm triển khai hạ tầng đám mây, tự động hóa CI/CD và tối ưu reliability."
    primaryCta={{ label: 'View Projects', href: '/projects' }}
    secondaryCta={{ label: 'Contact Me', href: '/contact' }}
    portrait="https://lh3.googleusercontent.com/aida-public/AB6AXuD_-2Ewbhk8F7wgMj9Uazg3YSY9CqJS8KxYHo6CwDf1vRxO7_3llJqdnE_m5pztgLyXox-aBAJ14ZtxkGzpSVjTPfzrH3Ut7dJOyUjFVszBj4xyRPLo83I6wBH_XclibseH2R7nZ2TAFspA2U2lRS5u2sTq-sMq5mQvr_6GNElXxcgFKdDwx1dd6jTrFSExHxtpQtO5VvVh78whdtJ6cpWhSTlg44rG1Bh1PJwh4KzUstspYGk7inYkEbqgH-pECbItS2hVn4w39ybO"
    stats={[
      { value: '3+', label: 'Years Exp' },
      { value: '50+', label: 'Projects' }
    ]}
  />
  <TechGrid title="Technologies I work with" items={techItems} />
</BaseLayout>
