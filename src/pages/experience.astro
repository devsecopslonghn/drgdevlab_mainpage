---
import BaseLayout from '@layouts/BaseLayout.astro';

const langProp = Astro.props.langOverride;
const lang = (langProp ?? Astro.url.searchParams.get('lang') ?? Astro.params?.lang) === 'vi' ? 'vi' : 'en';

const experiences = {
  en: [
    {
      role: 'DevOps Engineer – Banking',
      company: 'Sacombank',
      period: '2023 – Present',
      icon: 'verified',
      summary:
        'Built and ran CI/CD, release governance, and private Kubernetes/OKD for banking workloads with strict audit and security requirements.',
      achievements: [
        'Designed Jenkins (Pipeline as Code/Groovy) for multi-env releases (dev/SIT/UAT/staging/prod) with quality gates and rollbacks.',
        'Automated app distribution and tester access via Firebase CLI with CSV-based mapping and environment segregation.',
        'Aggregated test results across .NET/Java/Python for pipeline reporting and go/no-go decisions.',
        'Managed SQL change/versioning (DDL/DML/SP) in Git with rollback strategies aligned to audit and compliance.',
        'Enforced Docker image immutability and digest-based deployments for traceability.',
        'Built/operated on-prem Kubernetes/OKD (kubeadm, Vagrant, libvirt); implemented Traefik ingress, Cloudflare + Let’s Encrypt (DNS challenge/tunnel).',
        'Applied security-first practices: HTTPS/HSTS awareness, certificate lifecycle, and least-privilege access.'
      ],
      stack: ['Jenkins (Groovy)', 'GitLab', 'Docker', 'OKD/K8s', 'Traefik', 'Cloudflare', 'Let’s Encrypt', 'SQL change mgmt']
    },
    {
      role: 'DevOps Engineer',
      company: 'DXC Technology',
      period: '2021 – 2023',
      icon: 'deployed_code',
      summary:
        'Standardized CI/CD and environment provisioning for microservices and legacy apps, focusing on reliability and repeatable releases.',
      achievements: [
        'Built Jenkins/GitLab CI pipelines with automated testing, security scanning, and promotion gates.',
        'Containerized services with Docker; introduced Terraform/Ansible modules for consistent infra provisioning.',
        'Improved release governance with versioning, artifact integrity, and environment parity to lower rollout risk.'
      ],
      stack: ['Jenkins', 'GitLab CI', 'Docker', 'Terraform', 'Ansible']
    }
  ],
  vi: [
    {
      role: 'DevOps Engineer – Ngân hàng',
      company: 'Sacombank',
      period: '2023 – Hiện tại',
      icon: 'verified',
      summary:
        'Xây dựng và vận hành CI/CD, quản trị phát hành và Kubernetes/OKD on-prem cho hệ thống ngân hàng với yêu cầu audit và bảo mật nghiêm ngặt.',
      achievements: [
        'Thiết kế Jenkins (Pipeline as Code/Groovy) cho đa môi trường (dev/SIT/UAT/staging/prod) với quality gate và rollback.',
        'Tự động phân phối ứng dụng và quản lý tester bằng Firebase CLI, mapping CSV và tách biệt môi trường.',
        'Tổng hợp kết quả test .NET/Java/Python cho báo cáo pipeline và quyết định go/no-go.',
        'Quản lý thay đổi SQL (DDL/DML/SP) trong Git với chiến lược rollback tuân thủ kiểm toán.',
        'Áp dụng Docker image immutability và triển khai theo digest để truy vết chính xác.',
        'Xây dựng/vận hành Kubernetes/OKD on-prem (kubeadm, Vagrant, libvirt); cấu hình Traefik ingress, Cloudflare + Let’s Encrypt (DNS challenge/tunnel).',
        'Triển khai bảo mật ưu tiên: HTTPS/HSTS, vòng đời chứng chỉ, quyền truy cập least-privilege.'
      ],
      stack: ['Jenkins (Groovy)', 'GitLab', 'Docker', 'OKD/K8s', 'Traefik', 'Cloudflare', 'Let’s Encrypt', 'SQL change mgmt']
    },
    {
      role: 'DevOps Engineer',
      company: 'DXC Technology',
      period: '2021 – 2023',
      icon: 'deployed_code',
      summary:
        'Chuẩn hóa CI/CD và provisioning hạ tầng cho microservices và hệ thống legacy, tập trung vào tính ổn định và phát hành lặp lại.',
      achievements: [
        'Xây dựng Jenkins/GitLab CI với test tự động, security scan và cổng thăng cấp môi trường.',
        'Container hóa dịch vụ bằng Docker; giới thiệu module Terraform/Ansible cho provisioning nhất quán.',
        'Nâng chất lượng release với versioning, kiểm soát artifact và parity môi trường để giảm rủi ro rollout.'
      ],
      stack: ['Jenkins', 'GitLab CI', 'Docker', 'Terraform', 'Ansible']
    }
  ]
};

const labels = {
  en: {
    title: 'Work experience',
    description:
      'Three years focused on automation, cloud infrastructure, and system reliability. Highlights of my roles and outcomes.',
    achievements: 'Key achievements',
    ctaTitle: 'Want to learn more?',
    ctaBody: 'Download my full CV to see detailed projects and certifications.',
    download: 'Download full CV (PDF)'
  },
  vi: {
    title: 'Kinh nghiệm làm việc',
    description:
      'Ba năm tập trung vào tự động hóa, hạ tầng đám mây và tối ưu hệ thống. Dưới đây là tóm tắt các vị trí và giá trị tôi mang lại.',
    achievements: 'Thành tựu nổi bật',
    ctaTitle: 'Bạn muốn tìm hiểu chi tiết hơn?',
    ctaBody: 'Tải xuống CV đầy đủ của tôi để xem toàn bộ quá trình làm việc và chứng chỉ.',
    download: 'Tải CV đầy đủ (PDF)'
  }
};

const t = labels[lang];
const items = experiences[lang];
---

<BaseLayout
  title={lang === 'en' ? 'Work experience - DevOps Portfolio' : 'Kinh nghiệm làm việc - DevOps Portfolio'}
  description={lang === 'en' ? 'DevOps experience timeline' : 'Timeline kinh nghiệm DevOps'}
  lang={lang}
>
  <section class="flex-1 w-full px-4 py-10 md:px-6 md:py-16">
    <div class="mx-auto max-w-4xl flex flex-col gap-12">
      <div class="flex flex-col gap-4 text-center md:text-left">
        <h1 class="text-4xl md:text-5xl font-black tracking-tight text-transparent bg-clip-text bg-gradient-to-r from-white to-gray-400">
          {t.title}
        </h1>
        <p class="text-text-secondary text-lg font-normal max-w-2xl leading-relaxed">{t.description}</p>
      </div>

      <div class="relative flex flex-col gap-0 md:gap-4 px-2">
        {items.map((item, index) => (
          <div class="group relative grid grid-cols-[1fr] md:grid-cols-[60px_1fr] gap-x-6">
            <div class="hidden md:flex flex-col items-center pt-2">
              <div class={`flex size-12 items-center justify-center rounded-full border-2 ${index === 0 ? 'border-primary shadow-[0_0_15px_rgba(19,91,236,0.3)]' : 'border-surface-border'} bg-background-dark z-10`}>
                <span class={`material-symbols-outlined ${index === 0 ? 'text-primary' : 'text-text-secondary'}`}>{item.icon}</span>
              </div>
              <div class={`h-full w-[2px] ${index === items.length - 1 ? 'bg-gradient-to-b from-surface-border to-transparent' : 'bg-gradient-to-b from-primary via-surface-border to-surface-border'} my-2`}></div>
            </div>

            <div class={`relative ${index === items.length - 1 ? 'pb-4' : 'pb-12 md:pb-16'} pl-8 md:pl-0 border-l-2 border-surface-border md:border-l-0`}>
              <div class="absolute -left-[17px] top-0 flex md:hidden size-9 items-center justify-center rounded-full border-2 border-surface-border bg-background-dark z-10">
                <span class="material-symbols-outlined text-text-secondary text-sm">{item.icon}</span>
              </div>
              <div class="flex flex-col gap-5 rounded-2xl border border-surface-border bg-card-dark p-6 transition-all duration-300 hover:border-primary/50 hover:shadow-[0_4px_24px_rgba(0,0,0,0.2)]">
                <div class="flex flex-col md:flex-row md:items-start md:justify-between gap-2">
                  <div>
                    <h3 class="text-xl font-bold text-white group-hover:text-primary transition-colors">{item.role}</h3>
                    <div class="flex items-center gap-2 mt-1 text-text-secondary">
                      <span class="material-symbols-outlined text-[18px]">business</span>
                      <span class="text-base font-medium">{item.company}</span>
                    </div>
                  </div>
                  <span class={`self-start inline-flex items-center gap-1.5 rounded-full px-3 py-1.5 text-xs font-semibold ${index === 0 ? 'bg-primary/10 text-primary border border-primary/20' : 'bg-white/5 text-gray-300 border border-white/10'}`}>
                    <span class="material-symbols-outlined text-[14px]">calendar_month</span>
                    {item.period}
                  </span>
                </div>
                <p class="text-gray-300 text-sm leading-relaxed">{item.summary}</p>
                <div class="rounded-xl bg-background-dark/50 p-4 border border-surface-border/50">
                  <h4 class="text-sm font-semibold text-white mb-3 flex items-center gap-2">
                    <span class="material-symbols-outlined text-primary text-sm">emoji_events</span>
                    {t.achievements}
                  </h4>
                  <ul class="space-y-2.5">
                    {item.achievements.map((achievement) => (
                      <li class="flex items-start gap-3">
                        <span class={`material-symbols-outlined text-[18px] mt-0.5 ${index === 0 ? 'text-green-500' : 'text-primary'}`}>
                          {index === 0 ? 'check_circle' : 'check'}
                        </span>
                        <span class="text-sm text-gray-400">{achievement}</span>
                      </li>
                    ))}
                  </ul>
                </div>
                <div class="flex flex-wrap gap-2 pt-2">
                  {item.stack.map((tech) => (
                    <span class="px-3 py-1 rounded-md bg-surface-border text-xs font-medium text-gray-300 border border-[#3b4354]">{tech}</span>
                  ))}
                </div>
              </div>
            </div>
          </div>
        ))}
      </div>

      <div class="flex justify-center pt-10 border-t border-surface-border">
        <div class="flex flex-col items-center gap-4 text-center">
          <h3 class="text-xl font-bold text-white">{t.ctaTitle}</h3>
          <p class="text-text-secondary max-w-md">{t.ctaBody}</p>
          <a
            class="flex min-w-[180px] cursor-pointer items-center justify-center overflow-hidden rounded-lg h-12 px-6 bg-primary hover:bg-primary-hover text-white text-base font-bold leading-normal tracking-[0.015em] transition-all"
            href="/resume/Long_Ho_DevOps_Resume.pdf"
            target="_blank"
            rel="noreferrer"
          >
            <span class="truncate">{t.download}</span>
          </a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
