---
import BaseLayout from '@layouts/BaseLayout.astro';
import Navbar from '@components/Navbar.astro';
import Footer from '@components/Footer.astro';

const roles = [
  {
    company: 'Sacombank',
    role: 'DevOps Engineer',
    period: 'Nov 2024 — Present',
    domain: 'Core Banking · Open Banking · Payment Systems',
    summary: 'Platform and release engineering for regulated banking systems, with direct involvement in the Temenos T24 R25 production modernization.',
    bullets: [
      'Contributed to Sacombank\'s successful Temenos T24 R25 production upgrade through CI/CD automation, OpenShift delivery, Helm architecture, release standardization, and go-live support.',
      'Built the T24 R25 Transact umbrella Helm architecture with reusable templates and 18 component/workload charts across Develop, SIT, UAT, Staging, DR, and Production.',
      'One of four engineers supporting CI/CD delivery for approximately 400 source repositories across OpenShift microservices, WebSphere, JBoss, and other enterprise application platforms.',
      'Designed release-availability patterns using rolling, canary, blue-green, and controlled node-by-node deployment strategies; redesigned JBoss AML server groups and load-balancer flow to reduce deployment disruption.',
      'Integrated Coverity, SonarQube, Black Duck, Aqua, OWASP ZAP, Zimperium, Katalon, approval gates, artifact promotion, and release notifications into shared delivery workflows.',
      'Participated in the 2026 ISO 27001:2022 internal audit for the DevOps/CI-CD scope, supporting pipeline-control, release-governance, security-process, and audit-evidence reviews.'
    ],
    evidence: ['~400 repositories', '18 T24 workloads', '6 environments', '2 weeks → 3 days upgrade window']
  },
  {
    company: 'Accenture',
    role: 'Monitoring DevOps Engineer',
    period: 'Jul 2024 — Oct 2024',
    domain: 'LVMH Louis Vuitton · OVH Cloud',
    summary: 'Monitoring operations and incident-routing automation for enterprise infrastructure.',
    bullets: [
      'Monitored enterprise infrastructure with Datadog and Zabbix.',
      'Maintained alert-processing logic that aggregated monitoring events and generated structured tickets for partner response teams.'
    ],
    evidence: ['Datadog', 'Zabbix', 'Enterprise operations']
  },
  {
    company: 'DXC Technology Vietnam',
    role: 'DevOps Engineer',
    period: 'Sep 2022 — Jul 2024',
    domain: 'Allianz Philippines · AIA · PSMBFI',
    summary: 'Cloud infrastructure and CI/CD delivery for regulated insurance and financial-services clients.',
    bullets: [
      'Delivered end-to-end CI/CD and infrastructure automation using Jenkins, GitLab, Ansible, Terraform, Nexus, and JFrog.',
      'Provisioned AWS infrastructure including EC2, S3, RDS, ECS, IAM, API Gateway, and related platform services with Terraform.',
      'Reduced AWS non-production cost by 40% through resource rightsizing, auto-scaling policy changes, and spot-instance adoption.',
      'Completed a critical Allianz platform delivery within 100 days and received formal recognition for delivery quality and timeliness.'
    ],
    evidence: ['40% AWS non-prod cost reduction', 'Terraform on AWS', '100-day critical delivery']
  }
];

const releasePatterns = [
  ['Container platforms', 'Rolling, canary and blue-green rollout patterns with readiness and health validation, controlled traffic transition, and rollback paths.'],
  ['WebSphere / JBoss', 'Node-by-node or server-group rollout: drain traffic, deploy a controlled unit, validate health, restore traffic, then continue.'],
  ['Governance', 'Branch and tag rules, approval gates, artifact promotion, release notifications, and environment-specific controls from development through production.'],
  ['Observability', 'Grafana, Prometheus, Datadog, Zabbix and Kibana used to support release health, capacity visibility, and incident diagnosis.']
];

const skills = [
  ['CI/CD & SCM', 'Jenkins · Groovy Shared Pipeline/Stage · GitLab CI · GitHub Actions · Git · MR governance · GitOps'],
  ['Platform', 'Kubernetes · OpenShift · Docker · Helm · Argo CD · OpenTelemetry'],
  ['Security', 'Coverity · SonarQube · Black Duck · Aqua · OWASP ZAP · Zimperium'],
  ['Automation & IaC', 'Ansible · Terraform · Bash · Python · PowerShell · Groovy'],
  ['Artifacts', 'Nexus · JFrog · Maven/NuGet/raw repositories · Docker registry · Helm packages'],
  ['Enterprise', 'Temenos T24 R25 · WebSphere · JBoss · WebLogic · IIS · WSO2 · Flyway'],
  ['Cloud & Observability', 'AWS · Prometheus · Grafana · Datadog · Zabbix · Kibana']
];
---

<BaseLayout
  title="Experience — Long Ho"
  description="Experience in DevSecOps, CI/CD platform engineering, release engineering, core banking modernization, Kubernetes/OpenShift, and AWS infrastructure."
>
  <div class="min-h-screen bg-background-dark text-white">
    <Navbar />
    <main>
      <section class="site-shell pb-16 pt-16 md:pb-20 md:pt-24">
        <div class="max-w-4xl">
          <div class="eyebrow">Experience</div>
          <h1 class="mt-4 text-4xl font-semibold tracking-[-0.045em] text-white md:text-5xl lg:text-6xl">Production engineering across regulated systems.</h1>
          <p class="mt-6 max-w-3xl text-lg leading-8 text-text-muted">
            My work has moved from cloud infrastructure and CI/CD delivery into platform-scale release engineering for banking systems, while keeping security, auditability, and production availability as first-class constraints.
          </p>
        </div>
      </section>

      <section class="border-y border-border-dark">
        <div class="site-shell">
          {roles.map(job => (
            <article class="grid gap-8 border-b border-border-dark py-10 last:border-b-0 lg:grid-cols-[220px_1fr] lg:py-12">
              <div>
                <div class="font-mono text-xs text-text-subtle">{job.period}</div>
                <h2 class="mt-3 text-xl font-semibold text-white">{job.company}</h2>
                <div class="mt-1 text-sm text-primary">{job.role}</div>
                <div class="mt-2 text-xs leading-5 text-text-subtle">{job.domain}</div>
              </div>
              <div>
                <p class="max-w-3xl text-base leading-7 text-text-muted">{job.summary}</p>
                <ul class="mt-6 space-y-4">
                  {job.bullets.map(point => (
                    <li class="grid grid-cols-[18px_1fr] gap-3 text-sm leading-6 text-text-muted">
                      <span class="mt-[9px] h-1 w-1 rounded-full bg-primary"></span>
                      <span>{point}</span>
                    </li>
                  ))}
                </ul>
                <div class="mt-6 flex flex-wrap gap-x-5 gap-y-2 text-xs text-text-subtle">
                  {job.evidence.map(item => <span>{item}</span>)}
                </div>
              </div>
            </article>
          ))}
        </div>
      </section>

      <section class="section-space">
        <div class="site-shell">
          <div class="grid gap-12 lg:grid-cols-[.7fr_1.3fr]">
            <div>
              <div class="eyebrow">Release architecture</div>
              <h2 class="section-title">Availability is a deployment design problem.</h2>
              <p class="section-copy">I describe the mechanisms themselves rather than using an uptime percentage owned by a much larger system.</p>
            </div>
            <div class="border-t border-border-dark">
              {releasePatterns.map(row => (
                <div class="grid gap-3 border-b border-border-dark py-6 md:grid-cols-[180px_1fr]">
                  <h3 class="text-sm font-semibold text-white">{row[0]}</h3>
                  <p class="text-sm leading-6 text-text-muted">{row[1]}</p>
                </div>
              ))}
            </div>
          </div>

          <div class="mt-14 rounded-xl border border-border-dark bg-surface-dark/40 p-6 md:p-8">
            <div class="eyebrow">Deployment flow</div>
            <div class="mt-7 grid gap-3 md:grid-cols-[1fr_auto_1fr_auto_1fr_auto_1fr] md:items-center">
              {['Validate', 'Drain / Route', 'Deploy unit', 'Health check'].map((step, index) => (
                <>
                  <div class="rounded-lg border border-border-dark bg-background-dark px-4 py-4 text-center text-sm font-medium text-white">{step}</div>
                  {index < 3 && <div class="hidden text-center text-text-subtle md:block">→</div>}
                </>
              ))}
            </div>
            <div class="mt-4 text-xs leading-5 text-text-subtle">Repeat by pod, node, or server group depending on the target platform and release strategy.</div>
          </div>
        </div>
      </section>

      <section class="border-y border-border-dark bg-surface-dark/30">
        <div class="site-shell section-space">
          <div class="grid gap-10 lg:grid-cols-[.65fr_1.35fr]">
            <div>
              <div class="eyebrow">Technical domains</div>
              <h2 class="section-title">Tools grouped by responsibility.</h2>
              <p class="section-copy">No arbitrary proficiency percentages — just technologies used in the work described above.</p>
            </div>
            <div class="border-t border-border-dark">
              {skills.map(row => (
                <div class="grid gap-2 border-b border-border-dark py-5 sm:grid-cols-[170px_1fr]">
                  <div class="text-sm font-semibold text-white">{row[0]}</div>
                  <div class="text-sm leading-6 text-text-muted">{row[1]}</div>
                </div>
              ))}
            </div>
          </div>
        </div>
      </section>

      <section class="section-space">
        <div class="site-shell grid gap-10 lg:grid-cols-2">
          <div>
            <div class="eyebrow">Education</div>
            <h2 class="mt-3 text-xl font-semibold text-white">B.Sc. Information Technology</h2>
            <p class="mt-2 text-sm text-text-muted">University of Information Technology (UIT), Ho Chi Minh City · 2022</p>
          </div>
          <div>
            <div class="eyebrow">Certification</div>
            <h2 class="mt-3 text-xl font-semibold text-white">AWS Partner: Accreditation (Technical)</h2>
            <p class="mt-2 text-sm text-text-muted">Amazon Web Services · May 2024</p>
          </div>
        </div>
      </section>
    </main>
    <Footer />
  </div>
</BaseLayout>
