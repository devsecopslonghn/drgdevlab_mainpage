---
// CV / Resume page — optimized for print to PDF
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>Long Ho — DevSecOps & CI/CD Platform Engineer CV</title>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet" />
  <style>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

    :root {
      --green: #13ec80;
      --dark: #0d1410;
      --text: #1a1a1a;
      --muted: #555;
      --border: #e0e0e0;
      --tag-bg: #f0faf4;
      --tag-text: #0a7a3e;
    }

    body {
      font-family: 'Inter', sans-serif;
      font-size: 10.5pt;
      color: var(--text);
      background: #fff;
      line-height: 1.5;
    }

    /* ── Screen wrapper ── */
    .page-wrapper {
      max-width: 800px;
      margin: 0 auto;
      padding: 24px;
    }

    /* ── Print controls (hidden when printing) ── */
    .print-bar {
      position: fixed;
      top: 0; left: 0; right: 0;
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 10px 24px;
      background: var(--dark);
      color: #fff;
      font-size: 13px;
      z-index: 100;
      gap: 12px;
    }
    .print-bar span { color: #aaa; font-size: 12px; }
    .btn-print {
      display: flex;
      align-items: center;
      gap: 8px;
      background: var(--green);
      color: #0d1410;
      font-weight: 700;
      font-size: 13px;
      border: none;
      padding: 8px 20px;
      border-radius: 6px;
      cursor: pointer;
      text-decoration: none;
    }
    .btn-print:hover { opacity: 0.9; }
    .btn-back {
      color: #aaa;
      text-decoration: none;
      font-size: 12px;
    }
    .btn-back:hover { color: #fff; }

    .cv {
      margin-top: 56px; /* offset for fixed bar */
      background: #fff;
      border: 1px solid var(--border);
      border-radius: 8px;
      padding: 40px 44px;
    }

    /* ── HEADER ── */
    .cv-header {
      border-bottom: 2px solid #1a1a1a;
      padding-bottom: 16px;
      margin-bottom: 20px;
    }
    .cv-name {
      font-size: 26pt;
      font-weight: 800;
      color: var(--dark);
      letter-spacing: -0.5px;
      line-height: 1.1;
    }
    .cv-title {
      font-size: 11pt;
      font-weight: 500;
      color: var(--muted);
      margin-top: 4px;
      letter-spacing: 0.2px;
    }
    .cv-contacts {
      display: flex;
      flex-wrap: wrap;
      gap: 6px 20px;
      margin-top: 10px;
      font-size: 9pt;
      color: var(--muted);
    }
    .cv-contacts a { color: var(--muted); text-decoration: none; }
    .cv-contacts a:hover { color: var(--dark); }
    .cv-contacts span::before { content: '•'; margin-right: 6px; color: #999; }

    /* ── SECTIONS ── */
    .cv-section { margin-bottom: 18px; }
    .section-title {
      font-size: 8pt;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 1.2px;
      color: #1a1a1a;
      border-bottom: 1px solid #1a1a1a;
      padding-bottom: 4px;
      margin-bottom: 12px;
    }

    /* ── SUMMARY ── */
    .summary-text {
      font-size: 10pt;
      color: var(--muted);
      line-height: 1.65;
    }
    .summary-text strong { color: var(--dark); font-weight: 600; }

    /* ── EXPERIENCE ── */
    .job { margin-bottom: 14px; }
    .job:last-child { margin-bottom: 0; }
    .job-header { display: flex; justify-content: space-between; align-items: flex-start; gap: 8px; margin-bottom: 2px; }
    .job-title { font-size: 11pt; font-weight: 700; color: var(--dark); }
    .job-company { font-size: 10pt; font-weight: 600; color: #1a1a1a; }
    .job-period { font-size: 9pt; color: var(--muted); white-space: nowrap; text-align: right; }
    .job-domain { font-size: 9pt; color: var(--muted); font-style: italic; margin-bottom: 6px; }
    .job ul { padding-left: 14px; }
    .job li {
      font-size: 9.5pt;
      color: var(--muted);
      margin-bottom: 3.5px;
      line-height: 1.55;
    }
    .job li strong { color: var(--dark); font-weight: 600; }

    /* ── SKILLS TABLE ── */
    .skills-grid {
      display: grid;
      grid-template-columns: 140px 1fr;
      gap: 5px 12px;
      font-size: 9.5pt;
    }
    .skill-label { font-weight: 600; color: var(--dark); }
    .skill-value { color: var(--muted); }

    /* ── EDUCATION ── */
    .edu-row { display: flex; justify-content: space-between; align-items: center; }
    .edu-name { font-weight: 600; font-size: 10pt; color: var(--dark); }
    .edu-school { font-size: 9.5pt; color: var(--muted); }
    .edu-year { font-size: 9pt; color: var(--muted); }

    /* ── METRICS ROW ── */
    .metrics-row {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: 8px;
      margin: 10px 0 4px;
    }
    .metric-box {
      border: 1px solid #d0d0d0;
      background: #f7f7f7;
      border-radius: 6px;
      padding: 8px;
      text-align: center;
    }
    .metric-val { font-size: 14pt; font-weight: 800; color: #1a1a1a; }
    .metric-lbl { font-size: 7.5pt; color: var(--muted); margin-top: 2px; }

    /* ── PRINT STYLES ── */
    @media print {
      @page { margin: 14mm 14mm 14mm 14mm; size: A4; }
      .print-bar { display: none !important; }
      body { font-size: 9.5pt; }
      .cv {
        margin-top: 0;
        border: none;
        border-radius: 0;
        padding: 0;
      }
      .page-wrapper { padding: 0; max-width: 100%; }
      .cv-name { font-size: 22pt; }
      a { color: inherit !important; text-decoration: none !important; }
    }
  </style>
</head>
<body>

  <!-- Print bar (screen only) -->
  <div class="print-bar">
    <a href="/" class="btn-back">← Back to site</a>
    <span>Open in browser → Ctrl+P → Save as PDF · Recommended: A4, No margins, Background graphics ON</span>
    <button class="btn-print" onclick="window.print()">
      ⬇ Download PDF
    </button>
  </div>

  <div class="page-wrapper">
    <div class="cv">

      <!-- HEADER -->
      <div class="cv-header">
        <div class="cv-name">Long Ho</div>
        <div class="cv-title">DevSecOps & CI/CD Platform Engineer</div>
        <div class="cv-contacts">
          <span>longhn0710@gmail.com</span>
          <span>+84 332 792 848</span>
          <span>Ho Chi Minh City, Vietnam</span>
          <span><a href="https://linkedin.com/in/longhn0710">linkedin.com/in/longhn0710</a></span>
          <span><a href="https://github.com/devsecopslonghn">github.com/devsecopslonghn</a></span>
          <span><a href="https://drgdevlab.com">drgdevlab.com</a></span>
        </div>
      </div>

      <!-- SUMMARY -->
      <div class="cv-section">
        <div class="section-title">Summary</div>
        <p class="summary-text">
          DevSecOps / CI-CD Platform Engineer with <strong>4 years of experience</strong> across banking, insurance, and enterprise environments. Specializes in reusable delivery platforms, secure software supply chains, OpenShift/Kubernetes, release engineering, and infrastructure automation. One of a 4-person team supporting CI/CD for <strong>~400 source repositories</strong> at Sacombank, with direct contribution to the <strong>first successful Temenos T24 R25 core banking upgrade in Vietnam</strong> and active maintenance of the <strong>Jenkins Ansible Tower plugin</strong> in the Jenkins open-source ecosystem.
        </p>

      </div>

      <!-- EXPERIENCE -->
      <div class="cv-section">
        <div class="section-title">Experience</div>

        <div class="job">
          <div class="job-header">
            <div>
              <span class="job-title">DevOps Engineer</span>
              &nbsp;·&nbsp;
              <span class="job-company">Sacombank</span>
            </div>
            <div class="job-period">Nov 2024 – Present · Ho Chi Minh City</div>
          </div>
          <div class="job-domain">Core Banking · Open Banking · Payment Systems</div>
          <ul>
            <li>Contributed to <strong>Sacombank's successful Temenos T24 R25 production upgrade</strong> — the first successful T24 R25 core banking upgrade in Vietnam — through CI/CD automation, Helm-based modular deployment, release standardization, and production go-live support (upgrade window reduced from 2 weeks in R17/2017 to 3 days in R25/2026).</li>
            <li>Built the <strong>T24 R25 Transact umbrella Helm architecture</strong> on OpenShift with reusable templates and <strong>18 component/workload charts</strong>, supporting environment-specific delivery across Develop, SIT, UAT, Staging, DR, and Production.</li>
            <li>Designed <strong>high-availability release patterns</strong> across OpenShift and traditional middleware using rolling, canary, blue-green, and controlled node-by-node deployment strategies; redesigned JBoss AML server groups and load-balancer flow to remove avoidable deployment downtime.</li>
            <li>Architected <strong>branch-based CI/CD strategy</strong> with ITSM-gated production deployments and Microsoft Teams real-time notifications: develop → DEV; release/x.y → SIT; Git tag → QA email with one-click approval; master → ITSM change ticket → Jenkins → Ansible.</li>
            <li>Owned <strong>CI/CD pipeline onboarding</strong> for new projects: structured intake (repo, namespace, language, build version) → standard templates for OCP/WebSphere/JBoss, or researched and built from scratch — e.g. independently implemented full CI/CD and Ansible deployment logic for <strong>WSO2 API Manager</strong>.</li>
            <li>One of 4 engineers supporting CI/CD for <strong>~400 source repositories</strong> across OpenShift microservices, WebSphere, JBoss, and other enterprise application platforms; integrated <strong>Coverity, SonarQube, Black Duck, Aqua, OWASP ZAP, Zimperium, Katalon</strong>, and approval gates into delivery workflows.</li>
            <li>Improved operational reliability through <strong>Jenkins workspace cleanup automation</strong>, monitoring-driven capacity management, release health checks, rollback design, and observability with Grafana, Prometheus, Kibana, Datadog, and Zabbix.</li>
            <li>Participated in the <strong>2026 ISO 27001:2022 internal audit</strong> for the DevOps/CI-CD scope, supporting reviews of pipeline controls, release governance, security processes, and audit evidence.</li>
          </ul>
        </div>

        <div class="job">
          <div class="job-header">
            <div>
              <span class="job-title">Monitoring DevOps Engineer</span>
              &nbsp;·&nbsp;
              <span class="job-company">Accenture</span>
            </div>
            <div class="job-period">Jul 2024 – Oct 2024 · Ho Chi Minh City</div>
          </div>
          <div class="job-domain">Clients: LVMH Louis Vuitton · OVH Cloud</div>
          <ul>
            <li>Monitored enterprise infrastructure for global clients including <strong>LVMH Louis Vuitton</strong> and <strong>OVH Cloud</strong> using <strong>Datadog</strong> and <strong>Zabbix</strong>.</li>
            <li>Built and maintained alert logic pipeline: aggregated incidents from monitoring stack and auto-created structured tickets for partner response teams.</li>
          </ul>
        </div>

        <div class="job">
          <div class="job-header">
            <div>
              <span class="job-title">DevOps Engineer</span>
              &nbsp;·&nbsp;
              <span class="job-company">DXC Technology Vietnam</span>
            </div>
            <div class="job-period">Sep 2022 – Jul 2024 · Ho Chi Minh City</div>
          </div>
          <div class="job-domain">Clients: Allianz Philippines · AIA · PSMBFI</div>
          <ul>
            <li>Functioned as <strong>primary DevOps implementer</strong> for enterprise insurance clients on <strong>AWS</strong> — effectively sole technical executor for end-to-end CI/CD pipeline delivery across Allianz Philippines, AIA, and PSMBFI.</li>
            <li>Completed critical platform delivery for Allianz Philippines <strong>within 100 days</strong>, receiving formal recognition for delivery quality and timeliness.</li>
            <li>Reduced AWS non-production environment costs by <strong>40%</strong> through resource monitoring, instance rightsizing, auto-scaling policies, and spot instance adoption across dev, FT, UAT, and staging environments.</li>
            <li>Provisioned full AWS stack using <strong>Terraform</strong>: ECS clusters, API Gateway, Cognito (auth), IAM roles/policies, EC2, S3, RDS — end-to-end infrastructure for regulated financial services clients; automated configuration management with <strong>Ansible</strong> and Groovy-based Jenkins pipeline scripts.</li>
            <li>Built artifact management workflows with <strong>Nexus</strong> and <strong>JFrog Artifactory</strong>; implemented CI/CD compliance gates for regulated financial services clients.</li>
          </ul>
        </div>
      </div>

      <!-- SKILLS -->
      <div class="cv-section">
        <div class="section-title">Technical Skills</div>
        <div class="skills-grid">
          <span class="skill-label">CI/CD</span>
          <span class="skill-value">Jenkins, Jenkins Pipeline, Groovy Shared Pipeline/Stage, GitLab CI, GitHub Actions, Git, MR governance, GitOps</span>

          <span class="skill-label">Container & Orchestration</span>
          <span class="skill-value">OpenShift OCP, Kubernetes, Docker, Helm, Argo CD, OpenTelemetry annotations</span>

          <span class="skill-label">Automation & IaC</span>
          <span class="skill-value">Ansible, Terraform, Bash, Python, PowerShell, Groovy</span>

          <span class="skill-label">Cloud (AWS)</span>
          <span class="skill-value">EC2, S3, RDS, ECS, Auto Scaling, Spot Instances</span>

          <span class="skill-label">Database CI/CD</span>
          <span class="skill-value">Flyway, Custom Migration & Backup Scripts</span>

          <span class="skill-label">Monitoring & Logging</span>
          <span class="skill-value">Grafana, Prometheus, Datadog, Zabbix, Kibana</span>

          <span class="skill-label">Security</span>
          <span class="skill-value">Coverity, SonarQube, Black Duck, Aqua, OWASP ZAP, Zimperium</span>

          <span class="skill-label">Artifact Management</span>
          <span class="skill-value">Nexus, JFrog Artifactory</span>

          <span class="skill-label">App Servers</span>
          <span class="skill-value">WebSphere, JBoss, WebLogic, IIS, WSO2, Apache Tomcat</span>

          <span class="skill-label">Banking Systems</span>
          <span class="skill-value">Temenos T24 R25, Core Banking, Open Banking, Payment Systems, ppc64le/QEMU builds</span>
        </div>
      </div>

      <!-- EDUCATION -->
      <div class="cv-section">
        <div class="section-title">Education</div>
        <div class="edu-row">
          <div>
            <div class="edu-name">B.Sc. Information Technology</div>
            <div class="edu-school">University of Information Technology (UIT) — Ho Chi Minh City</div>
          </div>
          <div class="edu-year">2022</div>
        </div>
      </div>

      <!-- CERTIFICATIONS -->
      <div class="cv-section">
        <div class="section-title">Certifications</div>
        <div style="font-size: 9.5pt; color: var(--muted);">
          AWS Partner: Accreditation (Technical) — Amazon Web Services, May 2024
        </div>
      </div>

      <!-- PROJECTS -->
      <div class="cv-section">
        <div class="section-title">Projects</div>
        <div style="font-size: 9.5pt; color: var(--muted); display: flex; flex-direction: column; gap: 4px;">
          <div><strong style="color: var(--dark);">T24 R25 Transact Delivery Platform</strong> — Umbrella Helm architecture with reusable templates, 18 workloads, 6 environments, resource controls, image promotion, and CI/CD integration for Core Banking delivery</div>
          <div><strong style="color: var(--dark);">Jenkins Ansible Tower Plugin</strong> — Maintainer in the Jenkins open-source ecosystem; recent work spans AAP/AWX polling resilience, Jenkins compatibility, diagnostics/logging, Job DSL compatibility, security scanning, and regression coverage · <a href="https://github.com/jenkinsci/ansible-tower-plugin">github.com/jenkinsci/ansible-tower-plugin</a></div>
          <div style="margin-top: 4px;"><strong style="color: var(--dark);">Secure Delivery Lab</strong> — Reusable GitHub Actions for Java/Node/Python and Helm validation, with immutable image practices, SBOM/provenance design, Trivy/Gitleaks scanning, and GitOps-oriented delivery contracts</div>
        </div>
      </div>

    </div>
  </div>

</body>
</html>
