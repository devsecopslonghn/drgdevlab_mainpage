---
// NAB — Senior DevOps Engineer — tailored CV
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>Long Ho — CV · NAB Senior DevOps Engineer</title>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet" />
  <style>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
    :root {
      --green: #13ec80;
      --dark: #0d1410;
      --text: #1a1a1a;
      --muted: #555;
      --border: #e0e0e0;
    }
    body { font-family: 'Inter', sans-serif; font-size: 10.5pt; color: var(--text); background: #fff; line-height: 1.5; }
    .page-wrapper { max-width: 800px; margin: 0 auto; padding: 24px; }
    .print-bar {
      position: fixed; top: 0; left: 0; right: 0;
      display: flex; align-items: center; justify-content: space-between;
      padding: 10px 24px; background: var(--dark); color: #fff; font-size: 13px; z-index: 100; gap: 12px;
    }
    .print-bar span { color: #aaa; font-size: 12px; }
    .btn-print { display: flex; align-items: center; gap: 8px; background: var(--green); color: #0d1410; font-weight: 700; font-size: 13px; border: none; padding: 8px 20px; border-radius: 6px; cursor: pointer; text-decoration: none; }
    .btn-print:hover { opacity: 0.9; }
    .btn-back { color: #aaa; text-decoration: none; font-size: 12px; }
    .btn-back:hover { color: #fff; }
    .cv { margin-top: 56px; background: #fff; border: 1px solid var(--border); border-radius: 8px; padding: 40px 44px; }
    .cv-header { border-bottom: 2px solid #1a1a1a; padding-bottom: 16px; margin-bottom: 20px; }
    .cv-name { font-size: 26pt; font-weight: 800; color: var(--dark); letter-spacing: -0.5px; line-height: 1.1; }
    .cv-title { font-size: 11pt; font-weight: 500; color: var(--muted); margin-top: 4px; letter-spacing: 0.2px; }
    .cv-contacts { display: flex; flex-wrap: wrap; gap: 6px 20px; margin-top: 10px; font-size: 9pt; color: var(--muted); }
    .cv-contacts a { color: var(--muted); text-decoration: none; }
    .cv-contacts span::before { content: '•'; margin-right: 6px; color: #999; }
    .cv-section { margin-bottom: 18px; }
    .section-title { font-size: 8pt; font-weight: 700; text-transform: uppercase; letter-spacing: 1.2px; color: #1a1a1a; border-bottom: 1px solid #1a1a1a; padding-bottom: 4px; margin-bottom: 12px; }
    .summary-text { font-size: 10pt; color: var(--muted); line-height: 1.65; }
    .summary-text strong { color: var(--dark); font-weight: 600; }
    .job { margin-bottom: 14px; }
    .job:last-child { margin-bottom: 0; }
    .job-header { display: flex; justify-content: space-between; align-items: flex-start; gap: 8px; margin-bottom: 2px; }
    .job-title { font-size: 11pt; font-weight: 700; color: var(--dark); }
    .job-company { font-size: 10pt; font-weight: 600; color: #1a1a1a; }
    .job-period { font-size: 9pt; color: var(--muted); white-space: nowrap; text-align: right; }
    .job-domain { font-size: 9pt; color: var(--muted); font-style: italic; margin-bottom: 6px; }
    .job ul { padding-left: 14px; }
    .job li { font-size: 9.5pt; color: var(--muted); margin-bottom: 3.5px; line-height: 1.55; }
    .job li strong { color: var(--dark); font-weight: 600; }
    .skills-grid { display: grid; grid-template-columns: 150px 1fr; gap: 5px 12px; font-size: 9.5pt; }
    .skill-label { font-weight: 600; color: var(--dark); }
    .skill-value { color: var(--muted); }
    .edu-row { display: flex; justify-content: space-between; align-items: center; }
    .edu-name { font-weight: 600; font-size: 10pt; color: var(--dark); }
    .edu-school { font-size: 9.5pt; color: var(--muted); }
    .edu-year { font-size: 9pt; color: var(--muted); }
    @media print {
      @page { margin: 14mm 14mm 14mm 14mm; size: A4; }
      .print-bar { display: none !important; }
      body { font-size: 9.5pt; }
      .cv { margin-top: 0; border: none; border-radius: 0; padding: 0; }
      .page-wrapper { padding: 0; max-width: 100%; }
      .cv-name { font-size: 22pt; }
      a { color: inherit !important; text-decoration: none !important; }
    }
  </style>
</head>
<body>

