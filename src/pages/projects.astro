const labels = {
  en: {
    heading: 'Projects',
    subheading:
      'A collection of IaC assets, automation scripts, and CI/CD pipelines I have built over the last three years.',
    searchPlaceholder: 'Search projects (e.g. terraform, aws...)',
    github: 'GitHub'
  },
  vi: {
    heading: 'Dự án cá nhân',
    subheading:
      'Bộ sưu tập các dự án IaC, script tự động hóa và CI/CD pipelines tôi đã xây dựng trong suốt 3 năm làm việc và nghiên cứu.',
    searchPlaceholder: 'Tìm kiếm dự án (vd: terraform, aws...)',
    github: 'GitHub'
  }
};

const tLabels = labels[lang];
const tFilters = filters[lang];
const tProjects = projects[lang];
---

<BaseLayout
  title={lang === 'en' ? 'Projects - DevOps Portfolio' : 'Dự án cá nhân - DevOps Portfolio'}
  description={lang === 'en' ? 'Portfolio projects for IaC, CI/CD and automation' : 'Danh mục dự án IaC, CI/CD và tự động hóa'}
  lang={lang}
>
  <section class="flex flex-col items-center py-10 px-4 md:px-10">
    <div class="w-full max-w-[1024px] flex flex-col gap-8">
      <div class="flex flex-col gap-4">
        <h1 class="text-white text-4xl md:text-5xl font-black leading-tight tracking-[-0.033em]">{tLabels.heading}</h1>
        <p class="text-text-secondary text-lg font-normal leading-relaxed max-w-2xl">{tLabels.subheading}</p>
      </div>

      <div class="flex flex-col md:flex-row gap-4 justify-between items-start md:items-center">
        <div class="w-full md:w-auto min-w-[320px]">
          <label class="flex w-full items-stretch rounded-lg h-12 bg-card-dark border border-surface-border focus-within:border-primary transition-colors">
            <div class="text-text-secondary flex items-center justify-center pl-4 pr-2">
              <span class="material-symbols-outlined">search</span>
            </div>
            <input
              class="flex w-full bg-transparent border-none text-white focus:ring-0 placeholder:text-[#585f6f] px-2 text-base"
              placeholder={tLabels.searchPlaceholder}
              value=""
            />
          </label>
        </div>
        <div class="flex gap-2 flex-wrap">
          {tFilters.map((filter, index) => (
            <button
              class={`flex h-9 items-center justify-center px-4 rounded-lg text-sm font-medium transition-all ${
                index === 0
                  ? 'bg-primary text-white shadow-lg shadow-primary/25 hover:scale-105'
                  : 'bg-surface-border hover:bg-[#333a46] text-text-secondary hover:text-white'
              }`}
            >
              {filter}
            </button>
          ))}
        </div>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-6 pt-4">
        {tProjects.map((project) => (
          <div class="group flex flex-col bg-card-dark rounded-xl overflow-hidden border border-surface-border hover:border-primary/50 transition-all duration-300 hover:shadow-[0_0_20px_rgba(19,91,236,0.15)]">
            <div class="h-48 w-full relative">
              <img src={project.image} alt={project.title} class="absolute inset-0 h-full w-full object-cover" />
              <div class="absolute inset-0 bg-gradient-to-t from-card-dark to-transparent opacity-90"></div>
              {project.badge && (
                <div class="absolute top-4 right-4 bg-black/50 backdrop-blur-md px-3 py-1 rounded-full border border-white/10">
                  <span class="text-xs font-bold text-white tracking-wide">{project.badge}</span>
                </div>
              )}
            </div>
            <div class="flex flex-col flex-1 p-6 gap-4">
              <div class="flex items-start justify-between">
                <h3 class="text-xl font-bold text-white group-hover:text-primary transition-colors">{project.title}</h3>
                <span class="material-symbols-outlined text-text-secondary">{project.icon}</span>
              </div>
              <p class="text-text-secondary text-sm leading-relaxed line-clamp-2">{project.description}</p>
              <div class="flex flex-wrap gap-2 mt-auto">
                {project.tags.map((tag) => (
                  <span class="px-2.5 py-1 rounded-md bg-surface-border text-xs font-medium text-text-secondary font-mono">{tag}</span>
                ))}
              </div>
              <div class="pt-4 mt-2 border-t border-surface-border flex justify-between items-center">
                <div class="flex gap-4 text-xs text-text-secondary font-medium">
                  <span class="flex items-center gap-1">
                    <span class="material-symbols-outlined text-[16px]">star</span> {project.stars}
                  </span>
                  <span class="flex items-center gap-1">
                    <span class="material-symbols-outlined text-[16px]">call_split</span> {project.forks}
                  </span>
                </div>
                <button class="flex items-center gap-2 text-white bg-primary hover:bg-primary-hover px-4 py-2 rounded-lg text-sm font-semibold transition-colors">
                  <span>{tLabels.github}</span>
                  <span class="material-symbols-outlined text-[18px]">arrow_outward</span>
                </button>
              </div>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>
