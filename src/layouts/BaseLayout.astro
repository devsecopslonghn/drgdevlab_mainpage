---
import '@styles/global.css';
import { ViewTransitions } from 'astro:transitions';

const { title = 'DRG Dev Lab', description = 'Platform dashboard', lang = 'en', showChrome = false } = Astro.props;

const canonical = Astro.url?.href ?? '';
---

<!DOCTYPE html>
<html lang={lang} class="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:type" content="website" />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="alternate icon" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@400,0&display=swap" rel="stylesheet" />
    <ViewTransitions />
    <style>
      /* System font stack — zero network cost, renders instantly */
      :root {
        --font-display: -apple-system, BlinkMacSystemFont, 'Segoe UI', Inter, Roboto, Helvetica, Arial, sans-serif;
        --font-body: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;
      }
    </style>
  </head>
  <body class="min-h-screen flex flex-col">
    <div id="page-curtain" aria-hidden="true"></div>
    <main class="flex-1 flex flex-col">
      <slot />
    </main>
    {showChrome && <slot name="footer" />}

    <script>
      const curtain = document.getElementById('page-curtain');

      // Slide OUT on page enter (new page loaded)
      document.addEventListener('astro:page-load', () => {
        if (!curtain) return;
        curtain.classList.remove('is-entering');
        curtain.classList.add('is-leaving');
        curtain.addEventListener('animationend', () => {
          curtain.classList.remove('is-leaving');
          curtain.style.transform = 'translateX(-100%)';
        }, { once: true });
      });

      // Slide IN on navigation start (leaving current page)
      document.addEventListener('astro:before-preparation', () => {
        if (!curtain) return;
        curtain.style.transform = '';
        curtain.classList.remove('is-leaving');
        curtain.classList.add('is-entering');
      });
    </script>
  </body>
</html>
